SSH_HOST = os.environ.get("CONTAINER_WATCH_HOST", "unraid")
TG_CMD = os.environ.get("CONTAINER_WATCH_TG", "tg")
SELF_CONTAINER = "claude-bot"          # this assistant's own container: never judged

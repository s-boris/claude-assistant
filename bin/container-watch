TG_MAX = 600
GRACE_DAYS = 3
STALE_DAYS = 30                        # Unraid "update available" this long ...
STALE_MIN_BEHIND = 3                   # ... while at least this many stable releases piled up
SSH_TIMEOUT = 150
UA = "container-watch/1.0 (read-only update check)"
SEV = {"low": 1, "moderate": 2, "medium": 2, "high": 3, "critical": 4}
SEV_NAME = {1: "LOW", 2: "MEDIUM", 3: "HIGH", 4: "CRITICAL"}
SEC_RE = re.compile(r"(?i)\bsecurity\b|\bvulnerab\w*|\bCVE-\d{4}-\d{4,}|\bGHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}")
SEC_EXCL = re.compile(r"(?i)security[ -]?(policy|\.txt|\.md|-opt|context|tab\b)|SECURITY\.md|security\.txt")
PRE_RE = re.compile(r"(?i)(alpha|beta|nightly|preview|develop|\bdev\b|[-.]rc\.?\d*|\drc\d*$|\d(a|b)\d+$|-pre)")
GH = "https://api.github.com"

# Containers -> apps. match: regex on the image repo (registry and tag stripped). ver: version sources in
# order (api:<name>, label, history, env:<VAR>, mdns:ha). vpat: an installed version must look like this.
APPS = [

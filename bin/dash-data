#!/usr/bin/env python3
"""dash-data: collect safe-to-publish stats for the Claude Bot Dashboard (~/opt/dash).

  dash-data              write ~/.local/state/dash/data.json and the generated site ~/.local/state/dash/www
                         (what dash-publish copies): index.html = the data-free template ~/opt/dash/index.html
                         with the data inlined as its fallback copy, + data.json. The template never holds data;
                         {{key}} tokens in it are filled from the profile, only for the keys in PAGE_PROFILE_KEYS
  dash-data --inline     the same, plus www/dashboard.html: the page with the data embedded and no
                         doctype/head wrapper (ready for a claude.ai Artifact upload)
  dash-data --stdout     print the JSON instead of writing anything
  dash-data --no-cache   re-parse every transcript (normally only changed files are re-read)

What it reads (read-only): Claude Code transcripts (ONLY usage numbers, model, timestamps, tool names and
what kind of turn it was; never message text), subagent .meta.json descriptions, ~/jobs/**/*.jsonl result
records, TODO.md titles, PROACTIVE.md/CHANGELOG.md lines (shortened), crontab,
reminder counts (no text), agent-watch status, brain git log dates, channel-check/vault/browser status
lines (selected fields), disk/memory/load, the curated data map ~/.config/dash/dataflow.json, GOALS.md (goal
titles, step counts, next open step), dayline.json ("Today I did"; live `dayline --stdout` when the file is
older than today's log lines), the "Last night" card (PROACTIVE.md lines from 22:00 to 08:00, last 8 nights) and ~/.local/state/context/today.json (ONLY the HN picks and each source's
public status line: no reminders, location, Telegram content or coordinates).
The "codebase" block (Codebase tab): plugins, hooks and a rough
test-check count (grep, nothing is run), cached hourly in assistant-stats.json; skills/agents (minus any marked
private); brain git counts (live). Its strings get one `secretscan --redact` pass. Line counts are NOT here:
the "growth" block (~/.local/state/dash-growth.json from ~/bin/dash-growth: daily line counts by part, script/
skill/agent/crontab-line counts, CLAUDE.md KB, per-day heartbeats/owner messages/subagents, numbers only; refreshed
at most hourly) is the page's one line count, incl. today's lines by language. Today's activity point is taken
from this run's own counts, so it never lags.
Six tabs (Today, Usage, Activity, Codebase, Privacy, Architecture): every field shipped
is read by the page; duplicates (skills list, cron, changelog, brain) ship once.
Log-derived lines (Last night, Today I did, activity/changelog lists) also pass scrub(): amounts -> [amount],
people from the memory note -> 'someone' unless the rest of the page already shows that first name.
Every free-text field passes clean() (addresses, e-mails, phone/ID numbers, IPs, URLs with queries, long
digit runs are masked); the final JSON must pass `secretscan --stdin` or nothing is written (exit 3).
Cost is an ESTIMATE at Anthropic list prices (API-equivalent), not a bill.
"""
import argparse
import collections
import datetime as dt
import glob
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from zoneinfo import ZoneInfo

HOME = os.path.expanduser('~')
TZ = ZoneInfo('Europe/Zurich')
P = lambda *a: os.path.join(HOME, *a)  # noqa: E731

PROJECTS = os.environ.get('DASH_PROJECTS', P('.claude', 'projects'))
JOBS = os.environ.get('DASH_JOBS', P('jobs'))
STATE_DIR = os.environ.get('DASH_STATE', P('.local', 'state', 'dash'))
OUT = os.path.join(STATE_DIR, 'data.json')
CACHE = os.path.join(STATE_DIR, 'cache.json')
PAGE_DIR = os.environ.get('DASH_PAGE_DIR', P('opt', 'dash'))
INDEX = os.path.join(PAGE_DIR, 'index.html')            # the data-free template (repo: dash/index.html)
WWW_DIR = os.environ.get('DASH_WWW', os.path.join(STATE_DIR, 'www'))   # generated site: index.html + data.json
INLINE_OUT = os.path.join(WWW_DIR, 'dashboard.html')
PAGE_PROFILE_KEYS = ('network.server_name',)            # the only profile values the page may show ({{key}})
DATAFLOW = os.environ.get('DASH_DATAFLOW', P('.config', 'dash', 'dataflow.json'))
WORKSPACE = os.environ.get('DASH_WORKSPACE', P('workspace'))
HB_GATE_LOG = os.environ.get('DASH_HB_GATE_LOG', P('.local', 'state', 'hb-gate.log'))
DAYLINE = os.environ.get('DASH_DAYLINE', P('.local', 'state', 'dash', 'dayline.json'))
CONTEXT = os.environ.get('DASH_CONTEXT', P('.local', 'state', 'context', 'today.json'))
CACHE_VERSION = 3
KIND_KEYS = ('main', 'subagent', 'headless')
OWNER_TURNS = {'telegram': 'telegram', 'you (app/terminal)': 'app'}
TIMELINE_MAX_RUNS = 60

# USD per million tokens, Anthropic first-party list prices (claude-api skill, cached 2026-10-06).
# Cache writes: 5-minute TTL = 1.25x input, 1-hour TTL = 2x input.
PRICES = {
    'claude-opus-5-5': (4.00, 20.00, 0.20),
    'claude-sonnet-5-5': (2.00, 10.00, 0.10),  # cache read $0.10
    'claude-haiku-5-5': (0.10, 0.50, 0.01),
    'claude-fable-5-1': (10.00, 50.00, 0.25),
    'claude-fable-5': (10.00, 50.00, 1.00),
    'claude-opus-5': (5.00, 25.00, 0.50),
    'claude-opus-4-8': (5.00, 25.00, 0.50),
    'claude-opus-4-7': (5.00, 25.00, 0.50),
    'claude-opus-4-6': (5.00, 25.00, 0.50),
    'claude-sonnet-5': (2.00, 10.00, 0.20),
    'claude-sonnet-4-6': (3.00, 15.00, 0.30),
    'claude-haiku-4-5': (1.00, 5.00, 0.10),
}
DEFAULT_PRICE_MODEL = 'claude-opus-5-5'


def price_for(model):
    m = (model or '').lower()
    if m in PRICES:
        return PRICES[m], True
    for k in sorted(PRICES, key=len, reverse=True):
        if m.startswith(k):
            return PRICES[k], True
    return PRICES[DEFAULT_PRICE_MODEL], False


def cost_parts(model, inp, out, cr, cw5, cw1h):
    (pin, pout, pcr), _ = price_for(model)
    return {
        'input': inp * pin / 1e6,
        'output': out * pout / 1e6,
        'cache_read': cr * pcr / 1e6,
        'cache_write': (cw5 * pin * 1.25 + cw1h * pin * 2.0) / 1e6,
    }


# ----------------------------------------------------------------------------------------- privacy filter
RX_EMAIL = re.compile(r'[\w.+-]+@[\w-]+(?:\.[\w-]+)+')
RX_URLQ = re.compile(r'https?://([^\s/?#]+)[^\s?#]*\?[^\s)]*')
RX_IPV4 = re.compile(r'\b(?:\d{1,3}\.){3}\d{1,3}(?::\d+)?\b')
RX_PHONE = re.compile(r'(?<![\w.])\+?\d{2,3}[\s/.-]?\(?\d{2,3}\)?[\s/.-]?\d{3}[\s/.-]?\d{2}[\s/.-]?\d{2}(?![\w.])')
RX_IBAN = re.compile(r'\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}(?:\s?[A-Z0-9]{1,4})?\b')
RX_AHV = re.compile(r'\b756[.\s]?\d{4}[.\s]?\d{4}[.\s]?\d{2}\b')
RX_LONGNUM = re.compile(r'(?<![\w.-])\d[\d\s]{6,}\d(?![\w.-])')
RX_STREET = re.compile(r"\b[A-ZÄÖÜ][\wäöüßéè-]{1,}(?:strasse|straße|gasse|weg|platz|allee|rain|graben)\b(?:\s*\d+\s?[a-z]?\b)?")
RX_STREET2 = re.compile(r"\b(?:Via|Viale|Piazza|Corso|Rue|Chemin|Avenue|Route|Boulevard)\s+(?:[A-Z][\w'’.-]*\s+){0,4}\d+\s?[a-z]?\b")
RX_TOKENISH = re.compile(r'\b(?=[A-Za-z0-9_-]*\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{32,}\b')
RX_SECRET_WORDS = re.compile(r'(?i)\b(password|passwort|token|api[_ -]?key|secret|bearer)\s*[:=]\s*\S+')


def clean(text, maxlen=None):
    """Mask anything that identifies people or accounts, then shorten."""
    if text is None:
        return None
    s = str(text)
    s = s.replace('\r', ' ').replace('\n', ' ').replace('\t', ' ')
    s = RX_SECRET_WORDS.sub(lambda m: m.group(1) + ': [hidden]', s)
    s = RX_EMAIL.sub('[email]', s)
    s = RX_URLQ.sub(lambda m: m.group(1), s)
    s = RX_IPV4.sub('[ip]', s)
    s = RX_IBAN.sub('[iban]', s)
    s = RX_AHV.sub('[id]', s)
    s = RX_PHONE.sub('[phone]', s)
    s = RX_STREET2.sub('[address]', s)
    s = RX_STREET.sub('[street]', s)
    s = RX_TOKENISH.sub('[id]', s)
    s = RX_LONGNUM.sub('[number]', s)
    s = re.sub(r'\*\*|`', '', s)
    s = re.sub(r'\s{2,}', ' ', s).strip()
    if maxlen and len(s) > maxlen:
        cut = s[:maxlen - 1]
        sp = cut.rfind(' ')
        if sp > maxlen * 0.6:
            cut = cut[:sp]
        s = cut.rstrip(' ,;:-—') + '…'
    return s


def drop_parens(s):
    prev = None
    while prev != s:
        prev = s
        s = re.sub(r'\s*\([^()]*\)', '', s)
    i = s.find('(')
    if i >= 0:
        s = s[:i]
    return re.sub(r'\s{2,}', ' ', s).strip()


def first_clause(s, minlen=28):
    """Up to the first '; ' / '. ' / ' — ', taking one more clause when the first is very short."""
    out = ''
    rest = s
    while rest:
        m = re.search(r'; |\. | — ', rest)
        if not m:
            out += rest
            break
        out += rest[:m.start()]
        rest = rest[m.end():]
        if len(out) >= minlen:
            break
        out += '; '
    return out.strip(' ;.')


def title_of(text, maxlen=96):
    """Short title of a changelog/log line: parentheticals dropped, 'subject: first clause'."""
    s = drop_parens(clean(text) or '')
    subj, sep, rest = s.partition(': ')
    if sep and len(subj) <= 50 and rest:
        s = subj + ': ' + first_clause(rest)
    else:
        s = first_clause(s)
    return clean(s, maxlen)


def short_desc(text, maxlen=90):
    """Cron comment → one short phrase: parentheticals dropped, up to the first ':' / ';' / '.'."""
    s = drop_parens(clean(text) or '')
    s = re.split(r': |; |\. |\.$', s, maxsplit=1)[0]
    return clean(s, maxlen)


# ----------------------------------------------------------------------------------------- small helpers
def now_local():
    return dt.datetime.now(TZ)


def iso_epoch(ts):
    try:
        return dt.datetime.fromisoformat(str(ts).replace('Z', '+00:00')).timestamp()
    except (ValueError, TypeError):
        return None


def local(epoch):
    return dt.datetime.fromtimestamp(epoch, TZ)


def run(cmd, timeout=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           env=dict(os.environ, NO_COLOR='1', TERM='dumb'))
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, '', str(e)


def read_text(path):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return ''


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def human_dur(sec):
    sec = int(max(0, sec))
    d, r = divmod(sec, 86400)
    h, r = divmod(r, 3600)
    m = r // 60
    if d:
        return f'{d}d {h}h'
    if h:
        return f'{h}h {m}m'
    return f'{m}m'


# ----------------------------------------------------------------------------------------- transcripts
def tool_label(name):
    n = name or '?'
    if n.startswith('mcp__'):
        parts = n.split('__')
        server = parts[1] if len(parts) > 1 else 'mcp'
        tool = parts[-1]
        server = re.sub(r'^plugin_', '', server)
        server = re.sub(r'^claude_ai_', '', server)
        server = server.replace('telegram-plus_telegram', 'telegram').replace('_', ' ')
        tool = re.sub(r'^browser_', '', tool)
        return f'{server}: {tool}'
    return n


def classify_user(d):
    o = d.get('origin') or {}
    kind = o.get('kind') if isinstance(o, dict) else None
    m = d.get('message') or {}
    c = m.get('content')
    if isinstance(c, list):
        if all(isinstance(x, dict) and x.get('type') == 'tool_result' for x in c):
            return None
        c = ' '.join(x.get('text', '') for x in c if isinstance(x, dict) and x.get('type') == 'text')
    c = (c or '')[:40]
    if kind == 'channel':
        return 'telegram'
    if c.startswith('[heartbeat]') or (kind == 'plugin' and o.get('name') == 'heartbeat'):
        return 'heartbeat'   # the cron fallback types "[heartbeat]"; the mod's beats arrive as origin plugin/heartbeat
    if c.startswith('[self-scheduled'):
        return 'scheduled'
    if kind in ('task-notification', 'peer'):
        return 'agent'
    if kind == 'human':
        return 'you (app/terminal)'
    return None


def parse_transcript(path, stream_json=False):
    """Numbers only. Returns dict(msgs, tools, turns, costs, version)."""
    msgs = {}      # message id -> [ts, model, in, out, cr, cw5, cw1h]
    tools = {}     # tool_use id -> [ts, label]
    turns = {}     # ts string -> kind
    costs = {}     # startTime -> max totalCostUSD (Claude Code's own counter)
    results = []   # stream-json result records: [ts, {model: [in,out,cr,cw]}, cost]
    version = None
    last_ts = None
    with open(path, encoding='utf-8', errors='replace') as f:
        for line in f:
            # cheap substring pre-filter (spacing-agnostic); json.loads only for lines that can matter
            is_asst = '"assistant"' in line
            is_user = '"user"' in line and ('"origin"' in line or '[self-scheduled' in line or '[heartbeat]' in line)
            is_cost = '"cost-state"' in line
            is_result = stream_json and '"result"' in line
            if not (is_asst or is_user or is_cost or is_result):
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            t = d.get('type')
            ts = iso_epoch(d.get('timestamp')) if d.get('timestamp') else None
            if ts:
                last_ts = ts
            if t == 'assistant':
                m = d.get('message') or {}
                u = m.get('usage') or {}
                model = m.get('model') or '?'
                if d.get('version'):
                    version = d['version']
                for blk in m.get('content') or []:
                    if isinstance(blk, dict) and blk.get('type') == 'tool_use' and blk.get('id'):
                        tools[blk['id']] = [ts or last_ts, tool_label(blk.get('name'))]
                if model.startswith('<') or not u:
                    continue
                cc = u.get('cache_creation') or {}
                cwt = int(u.get('cache_creation_input_tokens') or 0)
                cw1h = int(cc.get('ephemeral_1h_input_tokens') or 0)
                cw5 = int(cc.get('ephemeral_5m_input_tokens') or 0)
                if cw1h + cw5 != cwt:
                    cw5 = max(0, cwt - cw1h)
                rec = [ts or last_ts, model, int(u.get('input_tokens') or 0), int(u.get('output_tokens') or 0),
                       int(u.get('cache_read_input_tokens') or 0), cw5, cw1h]
                mid = m.get('id') or d.get('requestId') or d.get('uuid')
                old = msgs.get(mid)
                if old is None or rec[3] >= old[3]:
                    msgs[mid] = rec
            elif t == 'user':
                k = classify_user(d)
                if k and d.get('timestamp'):
                    turns[d['timestamp']] = k
            elif t == 'cost-state':
                st = str(d.get('startTime'))
                c = float(d.get('totalCostUSD') or 0)
                costs[st] = max(costs.get(st, 0), c)
            elif t == 'result':
                mu = {}
                for model, v in (d.get('modelUsage') or {}).items():
                    mu[model] = [int(v.get('inputTokens') or 0), int(v.get('outputTokens') or 0),
                                 int(v.get('cacheReadInputTokens') or 0), int(v.get('cacheCreationInputTokens') or 0)]
                results.append([last_ts, mu, float(d.get('total_cost_usd') or 0)])
    return {'msgs': msgs, 'tools': tools, 'turns': turns, 'costs': costs, 'results': results,
            'version': version}


def load_cache(use):
    c = read_json(CACHE) if use else None
    return c.get('files', {}) if isinstance(c, dict) and c.get('v') == CACHE_VERSION else {}


def save_cache(files):
    atomic_write(CACHE, json.dumps({'v': CACHE_VERSION, 'files': files}, separators=(',', ':')))


def transcript_files():
    """(path, kind, label, stream_json) for every transcript we count."""
    out = []
    for proj in sorted(glob.glob(os.path.join(PROJECTS, '*'))):
        if not os.path.isdir(proj):
            continue
        pname = os.path.basename(proj)
        headless = pname.startswith('-home-node-jobs')
        for f in glob.glob(os.path.join(proj, '**', '*.jsonl'), recursive=True):
            rel = os.path.relpath(f, proj)
            if '/subagents/' in '/' + rel:
                out.append((f, 'subagent', None, False))
            elif headless:
                out.append((f, 'headless', 'job ' + pname.replace('-home-node-jobs-', ''), False))
            elif rel.count(os.sep) == 0:
                out.append((f, 'main', None, False))
    for f in glob.glob(os.path.join(JOBS, '**', '*.jsonl'), recursive=True):
        rel = os.path.relpath(f, JOBS)
        out.append((f, 'headless', 'job ' + rel.split(os.sep)[0], True))
    return out


def collect_tokens(use_cache=True):
    cache = load_cache(use_cache)
    newcache = {}
    files = transcript_files()
    parsed = []
    for path, kind, label, sj in files:
        try:
            st = os.stat(path)
        except OSError:
            continue
        key = path
        c = cache.get(key)
        if c and c.get('size') == st.st_size and c.get('mtime') == st.st_mtime:
            data = c['data']
        else:
            data = parse_transcript(path, stream_json=sj)
        newcache[key] = {'size': st.st_size, 'mtime': st.st_mtime, 'data': data}
        parsed.append((path, kind, label, sj, data))
    try:
        save_cache(newcache)
    except OSError:
        pass

    now = now_local()
    today = now.date()
    seen_msgs = set()
    seen_tools = set()
    seen_turns = {}
    rows = []          # [ts, kind, model, in, out, cr, cw5, cw1h, cost_override or None, run_key]
    tool_rows = []     # [ts, label]
    runs = {}          # run_key -> info
    cc_costs = {}
    version = None
    version_ts = 0
    for path, kind, label, sj, data in parsed:
        run_key = None
        if kind == 'subagent':
            aid = os.path.basename(path)[:-6].replace('agent-', '')
            run_key = 'sub:' + aid
            meta = read_json(path[:-6] + '.meta.json', {})
            runs[run_key] = {'id': aid[:8], 'kind': 'subagent', 'description': clean(meta.get('description') or 'subagent', 70),
                             'agent_type': clean(meta.get('agentType'), 30), 'effort': meta.get('effort'),
                             'background': meta.get('requestShape') == 'background', 'depth': meta.get('spawnDepth')}
        elif kind == 'headless':
            run_key = 'job:' + path
            rid = os.path.splitext(os.path.relpath(path, JOBS if path.startswith(JOBS) else os.path.dirname(path)))[0]
            runs[run_key] = {'id': clean(rid, 24), 'kind': 'headless', 'description': clean(label, 70),
                             'agent_type': 'claude -p', 'effort': None, 'background': True}
        for st_, c in (data.get('costs') or {}).items():
            cc_costs[st_] = max(cc_costs.get(st_, 0), c)
        if kind == 'main' and data.get('version'):
            mt = os.path.getmtime(path)
            if mt > version_ts:
                version, version_ts = data['version'], mt
        if sj and data.get('results'):
            # stream-json: the result record holds the accurate totals
            for ts, mu, cost in data['results']:
                ts = ts or os.path.getmtime(path)
                tot_tokens = sum(sum(v) for v in mu.values()) or 1
                for model, (i, o, r, w) in mu.items():
                    share = (i + o + r + w) / tot_tokens
                    rows.append([ts, kind, model, i, o, r, w, 0, cost * share, run_key])
        else:
            for mid, rec in data['msgs'].items():
                if mid in seen_msgs:
                    continue
                seen_msgs.add(mid)
                ts = rec[0] or os.path.getmtime(path)
                rows.append([ts, kind, rec[1], rec[2], rec[3], rec[4], rec[5], rec[6], None, run_key])
        for tid, (ts, lab) in data['tools'].items():
            if tid in seen_tools:
                continue
            seen_tools.add(tid)
            tool_rows.append([ts, lab, kind])
        if kind == 'main':
            for tss, k in data['turns'].items():
                seen_turns[tss] = k

    # ---- aggregate
    def blank():
        return {'messages': 0, 'input': 0, 'output': 0, 'cache_read': 0, 'cache_write': 0, 'tokens': 0,
                'cost_usd': 0.0, 'cost': {'input': 0.0, 'output': 0.0, 'cache_read': 0.0, 'cache_write': 0.0}}

    def add(b, r, parts, cost):
        b['messages'] += 1
        b['input'] += r[3]
        b['output'] += r[4]
        b['cache_read'] += r[5]
        b['cache_write'] += r[6] + r[7]
        b['tokens'] += r[3] + r[4] + r[5] + r[6] + r[7]
        b['cost_usd'] += cost
        for k, v in parts.items():
            b['cost'][k] += v

    totals = blank()
    by_kind = collections.defaultdict(blank)
    by_model = collections.defaultdict(blank)
    daily = collections.defaultdict(lambda: {'kinds': collections.defaultdict(int), 'ck': collections.defaultdict(float),
                                             'b': blank(), 'runs': set()})
    hourly = collections.defaultdict(lambda: {'kinds': collections.defaultdict(int), 'cost_usd': 0.0})
    unknown_models = set()
    run_stats = collections.defaultdict(lambda: {'start': None, 'end': None, 'b': blank(), 'models': set()})
    h_start = (now.replace(minute=0, second=0, microsecond=0) - dt.timedelta(hours=47))
    for r in rows:
        ts, kind, model = r[0], r[1], r[2]
        parts = cost_parts(model, r[3], r[4], r[5], r[6], r[7])
        _, known = price_for(model)
        if not known:
            unknown_models.add(model)
        cost = r[8] if r[8] is not None else sum(parts.values())
        r.append((parts, cost))  # the 24 h / 7 d windows add these unscaled parts
        if r[8] is not None:  # reported total: scale the parts to it so the split still adds up
            s = sum(parts.values()) or 1
            parts = {k: v * cost / s for k, v in parts.items()}
        add(totals, r, parts, cost)
        add(by_kind[kind], r, parts, cost)
        add(by_model[model], r, parts, cost)
        lt = local(ts)
        dkey = lt.date().isoformat()
        dd = daily[dkey]
        dd['kinds'][kind] += r[3] + r[4] + r[5] + r[6] + r[7]
        dd['ck'][kind] += cost
        add(dd['b'], r, parts, cost)
        if r[9]:
            rs = run_stats[r[9]]
            rs['start'] = ts if rs['start'] is None else min(rs['start'], ts)
            rs['end'] = ts if rs['end'] is None else max(rs['end'], ts)
            rs['models'].add(model)
            add(rs['b'], r, parts, cost)
        if lt >= h_start:
            hk = lt.strftime('%Y-%m-%dT%H')
            hourly[hk]['kinds'][kind] += r[3] + r[4] + r[5] + r[6] + r[7]
            hourly[hk]['cost_usd'] += cost

    for rk, rs in run_stats.items():
        if rs['start'] is not None:
            daily[local(rs['start']).date().isoformat()]['runs'].add(rk)

    def rnd(b):
        o = dict(b)
        o['cost_usd'] = round(o['cost_usd'], 4)
        o['cost'] = {k: round(v, 4) for k, v in o['cost'].items()}
        return o

    # tools + turns per day
    tools_all = collections.Counter()
    tools_daily = collections.defaultdict(collections.Counter)
    for ts, lab, kind in tool_rows:
        if not ts:
            continue
        tools_all[lab] += 1
        d = local(ts).date()
        tools_daily[d.isoformat()]['replies' if lab == 'telegram: reply' else 'calls'] += 1
    turns_daily = collections.defaultdict(collections.Counter)
    for tss, k in seen_turns.items():
        e = iso_epoch(tss)
        if e:
            turns_daily[local(e).date().isoformat()][k] += 1

    days = sorted(set(daily) | set(turns_daily) | set(tools_daily))
    daily_out = []
    if days:
        d0 = dt.date.fromisoformat(days[0])
        n = (today - d0).days + 1
        for i in range(max(n, 1)):
            dk = (d0 + dt.timedelta(days=i)).isoformat()
            dd = daily.get(dk) or {'kinds': {}, 'ck': {}, 'b': blank(), 'runs': ()}
            b, tdy = rnd(dd['b']), tools_daily.get(dk, {})
            daily_out.append({
                'date': dk,
                'tokens': {k: dd['kinds'].get(k, 0) for k in KIND_KEYS},
                'messages': b['messages'], 'cost_usd': b['cost_usd'], 'cost': b['cost'],
                'cost_by_kind': {k: round(dd['ck'].get(k, 0.0), 4) for k in KIND_KEYS},
                'input': b['input'], 'output': b['output'], 'cache_read': b['cache_read'], 'cache_write': b['cache_write'],
                'runs': len(dd['runs']),
                'subagent_runs': sum(1 for k in dd['runs'] if k.startswith('sub:')),
                'turns': dict(turns_daily.get(dk, {})),
                'tool_calls': tdy.get('calls', 0) + tdy.get('replies', 0),
                'telegram_replies': tdy.get('replies', 0),
            })

    hourly_out = []
    for i in range(48):
        h = h_start + dt.timedelta(hours=i)
        hk = h.strftime('%Y-%m-%dT%H')
        hh = hourly.get(hk) or {'kinds': {}, 'cost_usd': 0}
        hourly_out.append({'hour': hk, 'label': h.strftime('%H:00'), 'day': h.strftime('%a'),
                           'tokens': {k: hh['kinds'].get(k, 0) for k in KIND_KEYS},
                           'cost_usd': round(hh['cost_usd'], 4)})

    run_list = []
    for rk, rs in run_stats.items():
        info = runs.get(rk)
        if not info or rs['start'] is None:
            continue
        b = rnd(rs['b'])
        run_list.append(dict(info, start=local(rs['start']).strftime('%Y-%m-%d %H:%M'),
                             minutes=round((rs['end'] - rs['start']) / 60, 1), messages=b['messages'],
                             tokens=b['tokens'], output=b['output'], cost_usd=b['cost_usd'],
                             models=sorted(rs['models']), _start=rs['start']))
    top_runs = sorted(run_list, key=lambda x: -x['tokens'])[:15]
    recent_runs = sorted(run_list, key=lambda x: -x['_start'])[:15]
    for x in run_list:
        x.pop('_start', None)

    def window(hours):
        cut = now.timestamp() - hours * 3600
        b = blank()
        for r in rows:
            if r[0] >= cut:
                add(b, r, *r[10])
        return rnd(b)

    today_key = today.isoformat()
    td = next((d for d in daily_out if d['date'] == today_key), None)

    # cost pace: today so far vs the average of the (up to) 14 full days before it that have data
    prev = [d for d in daily_out if d['date'] < today_key][-14:]
    avg = round(sum(d['cost_usd'] for d in prev) / len(prev), 4) if prev else None
    today_usd = td['cost_usd'] if td else 0.0
    day_frac = (now - now.replace(hour=0, minute=0, second=0, microsecond=0)).total_seconds() / 86400
    cost_pace = {
        'days': len(prev), 'avg_usd': avg, 'today_usd': today_usd,
        'today_pct_of_avg': round(today_usd / avg * 100, 1) if avg else None,
        'day_elapsed_pct': round(day_frac * 100, 1),
    }

    # timeline of the last 24 h: agent/worker runs as bars, the owner's messages as dots (times only, no text)
    t_cut = now.timestamp() - 24 * 3600
    tl_runs = []
    for rk, rs in run_stats.items():
        info = runs.get(rk)
        if not info or rs['start'] is None or rs['end'] < t_cut:
            continue
        tl_runs.append({'start': local(rs['start']).isoformat(timespec='seconds'),
                        'end': local(rs['end']).isoformat(timespec='seconds'),
                        'kind': info['kind'], 'description': info['description'],
                        'agent_type': info.get('agent_type'), 'effort': info.get('effort'),
                        'minutes': round((rs['end'] - rs['start']) / 60, 1),
                        'cost_usd': round(rs['b']['cost_usd'], 4), '_s': rs['start']})
    tl_runs.sort(key=lambda x: x['_s'])
    for x in tl_runs:
        x.pop('_s')
    owner_msgs = []
    for tss, k in seen_turns.items():
        e = iso_epoch(tss)
        if e and e >= t_cut and k in OWNER_TURNS:
            owner_msgs.append({'at': local(e).isoformat(timespec='seconds'), 'via': OWNER_TURNS[k]})
    owner_msgs.sort(key=lambda x: x['at'])
    timeline = {'from': local(t_cut).isoformat(timespec='seconds'), 'to': now.isoformat(timespec='seconds'),
                'runs': tl_runs[-TIMELINE_MAX_RUNS:], 'runs_dropped': max(0, len(tl_runs) - TIMELINE_MAX_RUNS),
                'owner_messages': owner_msgs}
    first = min((r[0] for r in rows), default=None)
    last = max((r[0] for r in rows), default=None)
    pricing = {m: {'input': p[0], 'output': p[1], 'cache_read': p[2], 'cache_write_5m': round(p[0] * 1.25, 4),
                   'cache_write_1h': p[0] * 2} for m, p in PRICES.items() if m in by_model}
    return {
        'note': ('Estimated cost at Anthropic list prices (API-equivalent, USD). If you are on a Claude subscription '
                 'this is not what you pay; it shows how heavy the usage is.'),
        'pricing_usd_per_mtok': pricing,
        'first': local(first).isoformat(timespec='minutes') if first else None,
        'last': local(last).isoformat(timespec='minutes') if last else None,
        'totals': rnd(totals),
        'by_kind': {k: rnd(v) for k, v in by_kind.items()},
        'by_model': sorted(({'model': m, **rnd(v)} for m, v in by_model.items()), key=lambda x: -x['tokens']),
        'today': td,
        'cost_pace': cost_pace,
        'timeline': timeline,
        'last_24h': window(24),
        'last_7d': window(24 * 7),
        'daily': daily_out,
        'hourly': hourly_out,
        'top_runs': top_runs,
        'recent_runs': recent_runs,
        'runs_total': len(run_list),
        'tools_top': [{'name': n, 'calls': c} for n, c in tools_all.most_common(15)],
        'tool_calls_total': sum(tools_all.values()),
        'claude_code_counter_usd': round(sum(cc_costs.values()), 2),
        'claude_code_counter_note': ("Claude Code's own running cost counter for the main session processes "
                                     '(written only now and then, so it lags; includes subagents).'),
        'claude_code_version': version,
        'transcript_files': len(parsed),
    }


# ----------------------------------------------------------------------------------------- activity
def parse_todo():
    txt = read_text(os.path.join(WORKSPACE, 'TODO.md'))
    sections = {}
    cur = None
    for line in txt.splitlines():
        m = re.match(r'^##\s+(.*)$', line)
        if m:
            cur = m.group(1).strip().lower()
            sections[cur] = []
            continue
        if cur is None or not line.startswith('- '):
            continue
        item = line[2:].strip()
        b = re.match(r'\*\*(.+?)\*\*', item)
        title = b.group(1) if b else re.split(r'\s+—\s+|:\s', item, maxsplit=1)[0]
        sections[cur].append(clean(title.rstrip(':'), 80))
    return {
        'due': sections.get('due', []),
        'in_progress': sections.get('in progress', []),
        'waiting': sections.get('waiting on you', []),
        'ideas': sections.get('ideas', []),
    }


def parse_log(path, n=30, with_time=True):
    out = []
    for line in read_text(path).splitlines():
        m = re.match(r'^- (\d{4}-\d\d-\d\d)(?:[ T](\d\d:\d\d))?\s*(?:—|–|-|:)?\s*(.*)$', line)
        if not m:
            continue
        text = m.group(3)
        kind = None
        km = re.match(r'(started|done|finished|failed)\s*:\s*(.*)$', text, re.I)
        if km:
            kind = km.group(1).lower()
            text = km.group(2)
        out.append({'date': m.group(1), 'time': m.group(2), 'kind': kind, 'text': title_of(text, 96)})
    return out[-n:][::-1]


RX_GOAL = re.compile(r'^##\s+(?:(\d+)[.)]\s*)?(.+?)\s*$')
RX_STEP = re.compile(r'^\s*[-*]\s+\[([ xX])\]\s+(.*)$')
RX_BLOCKED = re.compile(r'\b(blocked|parked|waiting)\b', re.I)


def parse_goals(path=None):
    """GOALS.md: '## N. Title (notes)' + '- [ ]' / '- [x]' steps -> titles, counts and the next unblocked step."""
    goals = []
    cur = None
    for line in read_text(path or os.path.join(WORKSPACE, 'GOALS.md')).splitlines():
        m = RX_GOAL.match(line)
        if m:
            cur = {'n': int(m.group(1)) if m.group(1) else len(goals) + 1, 'title': clean(drop_parens(m.group(2)), 60),
                   'open': 0, 'done': 0, 'blocked': 0, 'next': None, 'next_blocked': False}
            goals.append(cur)
            continue
        s_ = RX_STEP.match(line) if cur else None
        if not s_:
            continue
        if s_.group(1).lower() == 'x':
            cur['done'] += 1
            continue
        cur['open'] += 1
        blocked = bool(RX_BLOCKED.search(s_.group(2)))
        cur['blocked'] += blocked
        if cur['next'] is None or (cur['next_blocked'] and not blocked):
            cur['next'], cur['next_blocked'] = title_of(s_.group(2), 80), blocked
    for g in goals:
        g['total'] = g['open'] + g['done']
        g['pct'] = round(100 * g['done'] / g['total']) if g['total'] else 0
    return {'goals': goals, 'open': sum(g['open'] for g in goals), 'done': sum(g['done'] for g in goals),
            'total': sum(g['total'] for g in goals)}


def dayline():
    """'Today I did': dayline.json (21:07 cron), or a live `dayline --stdout` when the file is not from today or
    PROACTIVE/CHANGELOG changed after it was written."""
    today = now_local().strftime('%Y-%m-%d')
    try:
        d = json.loads(read_text(DAYLINE) or 'null')
    except ValueError:
        d = None
    newest_log = max((os.path.getmtime(os.path.join(WORKSPACE, f)) for f in ('PROACTIVE.md', 'CHANGELOG.md')
                      if os.path.exists(os.path.join(WORKSPACE, f))), default=0)
    if not isinstance(d, dict) or d.get('date') != today or os.path.getmtime(DAYLINE) < newest_log:
        try:
            r = subprocess.run([P('bin', 'dayline'), '--stdout'], capture_output=True, text=True, timeout=20,
                               env=dict(os.environ, DAYLINE_WORKSPACE=WORKSPACE))
            if r.returncode == 0:
                d = json.loads(r.stdout)
        except (OSError, subprocess.TimeoutExpired, ValueError):
            pass
    if not isinstance(d, dict) or not d.get('date'):
        return None
    return {
        'date': str(d['date'])[:10], 'today': d['date'] == today,
        'done': [{'time': e.get('time'), 'kind': e.get('kind'), 'text': title_of(e.get('text'), 96)}
                 for e in (d.get('proactive') or [])[::-1][:20] if isinstance(e, dict)],
        'changes': len(d.get('changes') or []),
    }


# ----------------------------------------------------------------------------------------- names and amounts
# PROACTIVE/CHANGELOG are my own logs, but a line can still carry a name or a sum (e.g. a calendar or insurance
# note). On top of clean(), every log-derived line (Last night, Today I did, the activity and changelog lists):
# money -> [amount]; people from the memory note -> 'someone' (a first name stays only when the rest of the
# dashboard already shows it, surnames never); "X's" of a capitalized word the rest of the dashboard never shows
# -> "someone's" (names I have no note on).
PEOPLE_NOTE = os.environ.get('DASH_PEOPLE', P('.claude', 'projects', '-home-node-workspace', 'memory', 'people-and-dates.md'))
NOT_NAMES = set('''Jan January Feb February Mar March Apr April May Jun June Jul July Aug August Sep Sept September Oct
October Nov November Dec December Mon Monday Tue Tuesday Wed Wednesday Thu Thursday Fri Friday Sat Saturday Sun Sunday
The This That These His Her Their Owner Family Close Friends How Related Never Use Also Only When What Who Not None
Google Calendar Telegram Gmail'''.split())   # generic words only: anything else in the note counts as a name (masking is safe)
_CUR = r"(?:CHF|SFr\.?|Fr\.|EUR|USD|GBP|US\$|\$|€|£)"
_NUM = r"~?\d[\d'’.,]*"
RX_MONEY = re.compile(_CUR + r"\s?" + _NUM + r"(?:\s?[–-]\s?" + _NUM + r")?(?:\s?(?:k|Mio\.?|M)\b)?(?:\.?[–-](?!\d))?"
                      r"|(?<![\w.])" + _NUM + r"(?:\s?k)?\s?(?:CHF|SFr|Fr\.|EUR|USD|GBP|€|£|francs?|Franken|dollars?|euros?)(?![A-Za-z])"
                      r"|(?<![\w.])\d[\d'’]*\.[–-](?!\d)")
RX_MONEY_WORD = re.compile(r"(?i)\b(paid|pay|pays|costs?|prices?|priced|premiums?|prämien?|rent|miete|salary|lohn|refund|"
                           r"fees?|balance|saldo|owes?|owed)\b(\s*(?:of|is|was|=|:|about|ca\.?)?\s*)(" + _NUM + r")"
                           r"(?![\d'’.,]*\d)(?!\s?(?:%|[KMGT]i?B\b|[kKMB]\b|h\b|min\b|days?\b|tokens?\b|lines?\b|tests?\b|runs?\b|items?\b|x\b))")
RX_DEC2 = re.compile(r"(?<![\w.'’/])(\d{1,3}(?:['’]\d{3})+|\d+)\.(\d\d)(?![\w.]|\s?(?:[KMGT]i?B\b|%|°|h\b|min\b|ms\b|s\b|x\b))")
RX_NAMEWORD = r"[A-ZÄÖÜ][a-zäöüéèëçñ]{2,}"
RX_POSSESSIVE = re.compile(r"(?<!\bThe )\b([A-ZÄÖÜ][\wäöüéè-]*)['’]s\b")


def mask_amounts(s):
    s = RX_MONEY.sub('[amount]', s)
    s = RX_MONEY_WORD.sub(lambda m: m.group(1) + m.group(2) + '[amount]', s)

    def dec2(m):   # 375.00 / 1'250.50 -> amount; 13.10 (a DD.MM date) stays
        d, mo = int(re.sub(r"\D", '', m.group(1))), int(m.group(2))
        return m.group(0) if 1 <= d <= 31 and 1 <= mo <= 12 and "'" not in m.group(1) and '’' not in m.group(1) else '[amount]'
    return RX_DEC2.sub(dec2, s)


_PEOPLE = None


def people():
    """(first names, surnames) from the people note. Surnames: the second word of 'First [“Nick”] Last' pairs."""
    global _PEOPLE
    if _PEOPLE is None:
        txt = re.sub(r'(?s)\A---.*?\n---', '', read_text(PEOPLE_NOTE))
        words = set(re.findall(r'\b' + RX_NAMEWORD + r'\b', txt)) - NOT_NAMES
        sur = {b for a, b in re.findall(r'\b(' + RX_NAMEWORD + r')\s+(?:"[^"\n]+"\s+)?(' + RX_NAMEWORD + r')\b', txt)
               if a in words and b in words}
        _PEOPLE = (words - sur, sur)
    return _PEOPLE


def shown_words(data, skip):
    """Capitalized words the dashboard already shows outside the log-derived blocks (skip = (block, key) pairs)."""
    out = set()
    for k, v in data.items():
        if isinstance(v, dict):
            v = {kk: vv for kk, vv in v.items() if (k, kk) not in skip}
        for s in strings_of(v):
            out.update(re.findall(r'\b[A-ZÄÖÜ][\wäöüéè-]+', s))
    return out


def strings_of(o):
    if isinstance(o, str):
        yield o
    elif isinstance(o, dict):
        for v in o.values():
            yield from strings_of(v)
    elif isinstance(o, (list, tuple)):
        for v in o:
            yield from strings_of(v)


def scrub(text, shown=frozenset()):
    """Names and amounts out of one log line (see above); clean() and title_of() still do the rest."""
    if not text:
        return text
    s = mask_amounts(str(text))
    first, sur = people()
    hide = (first - set(shown)) | sur
    if hide:
        s = re.sub(r'\b(?:' + '|'.join(sorted(map(re.escape, hide), key=len, reverse=True)) + r')\b', 'someone', s)
    s = RX_POSSESSIVE.sub(lambda m: m.group(0) if m.group(1) in shown or m.group(1) == 'someone' else "someone's", s)
    s = re.sub(r'\bsomeone(?:\s+(?:"[^"]*"\s+)?someone)+\b', 'someone', s)
    return s


def scrub_tree(o, shown):
    if isinstance(o, str):
        return scrub(o, shown)
    if isinstance(o, list):
        return [scrub_tree(x, shown) for x in o]
    if isinstance(o, dict):
        return {k: (scrub_tree(v, shown) if k in ('text', 'done', 'changes') or not isinstance(v, str) else v)
                for k, v in o.items()}
    return o


# ----------------------------------------------------------------------------------------- last night
# "Last night" card: what I built between 22:00 the evening before and 08:00, from PROACTIVE.md lines
# "- YYYY-MM-DD HH:MM text" (a leading ~ before the time is fine). Lines without a time are skipped (only counted).
NIGHTS = 7
NIGHT_ITEMS = 40
RX_LOG = re.compile(r'^- (\d{4}-\d\d-\d\d)(?:[ T]~?(\d\d:\d\d))?\s*(?:—|–|-|:)?\s*(.*)$')
RX_LOG_KIND = re.compile(r'(started|done|finished|failed)(?=[\s:]|$)\s*:?\s*(.*)$', re.I)


def night_of(day, hhmm):
    """Morning date of the night a log line belongs to: 22:00 the evening before .. 07:59; None by day."""
    if hhmm < '08:00':
        return day
    if hhmm >= '22:00':
        return day + dt.timedelta(days=1)
    return None


def lastnight(shown=frozenset(), now=None):
    now = now or now_local()
    hm = now.strftime('%H:%M')
    cur = now.date() + dt.timedelta(days=1) if hm >= '22:00' else now.date()
    days = [cur - dt.timedelta(days=i) for i in range(NIGHTS + 2)]
    buckets = {d: [] for d in days}
    untimed = 0
    for line in read_text(os.path.join(WORKSPACE, 'PROACTIVE.md')).splitlines():
        m = RX_LOG.match(line)
        if not m:
            continue
        try:
            day = dt.date.fromisoformat(m.group(1))
        except ValueError:
            continue
        if not m.group(2):
            untimed += days[-1] - dt.timedelta(days=1) <= day <= cur
            continue
        n = night_of(day, m.group(2))
        if n not in buckets:
            continue
        text, kind = m.group(3).strip(), None
        km = RX_LOG_KIND.match(text)
        if km:
            kind = 'done' if km.group(1).lower() == 'finished' else km.group(1).lower()
            text = km.group(2)
        text = title_of(scrub(text, shown), 90)
        if text:
            buckets[n].append((m.group(1), m.group(2), {'time': m.group(2), 'kind': kind, 'text': text}))
    nights = []
    for d in days:
        items = [x[2] for x in sorted(buckets[d], key=lambda x: (x[0], x[1]))]
        nights.append({'date': d.isoformat(), 'in_progress': d == cur and (hm < '08:00' or hm >= '22:00'),
                       'count': len(items), 'items': items[:NIGHT_ITEMS]})
    i = 1 if nights[0]['in_progress'] and not nights[0]['count'] else 0   # empty night just begun: keep showing the last one
    return {'window': '22:00–08:00', 'tonight': nights[i], 'earlier': nights[i + 1:i + 1 + NIGHTS], 'untimed': untimed}


CONTEXT_TAGS = ('AI', 'self-hosting', 'finance', 'games', 'science')


def context_card():
    """Only the public parts of ~/bin/context's snapshot: HN picks and per-source status lines."""
    try:
        c = json.loads(read_text(CONTEXT) or 'null')
    except ValueError:
        return None
    if not isinstance(c, dict):
        return None
    ts = iso_epoch(c.get('generated_at'))
    picks = []
    for x in ((c.get('hn') or {}).get('picks') or [])[:10]:
        try:
            picks.append({'id': int(x['id']), 'title': clean(x.get('title'), 110), 'points': int(x.get('points') or 0),
                          'domain': clean(x.get('domain'), 40), 'tags': [t for t in x.get('tags') or [] if t in CONTEXT_TAGS]})
        except (KeyError, TypeError, ValueError):
            continue
    return {'generated_local': local(ts).strftime('%Y-%m-%d %H:%M') if ts else None,
            'age_min': round((time.time() - ts) / 60) if ts else None, 'hn': picks}


def server_checks():
    """Server health (the Unraid report's critical/warning counts) and array capacity from the context snapshot, as
    health checks next to the container's own (Health once said all OK while the server had 2 critical)."""
    try:
        c = json.loads(read_text(CONTEXT) or 'null')
    except ValueError:
        return []
    srv = c.get('server') if isinstance(c, dict) else None
    if not isinstance(srv, dict):
        return []
    ts = iso_epoch(c.get('generated_at'))
    stale = not ts or time.time() - ts > 26 * 3600
    when = (' · snapshot ' + local(ts).strftime('%d.%m. %H:%M')) if ts else ''
    out = []
    hl = srv.get('health')
    if isinstance(hl, str) and hl.strip():
        cr, wa = re.search(r'(\d+)\s+critical', hl), re.search(r'(\d+)\s+warning', hl)
        crit, warn = int(cr.group(1)) if cr else 0, int(wa.group(1)) if wa else 0
        rep = re.search(r'report (\d{4}-\d\d-\d\d \d\d:\d\d)', hl)
        st = 'unknown' if stale or not (cr or wa) else 'critical' if crit else 'warn' if warn else 'ok'
        out.append(check('Server (Unraid)', st, f'{crit} critical · {warn} warning' + ('' if warn == 1 else 's'),
                         'Unraid health report' + (f' of {rep.group(1)}' if rep else '') + when))
    cap = srv.get('capacity')
    if isinstance(cap, str) and cap.strip():
        p, d = re.search(r'([\d.]+)%\s*used', cap), re.search(r'in (\d+) d\b', cap)
        pct, days = (float(p.group(1)) if p else None), (int(d.group(1)) if d else None)
        st = ('unknown' if stale or pct is None else
              'critical' if pct >= 97 or (days is not None and days < 14) else
              'warn' if pct >= 90 or (days is not None and days < 60) else 'ok')
        out.append(check('Array capacity', st, (f'{pct:.0f}% used' if pct is not None else '?') +
                         (f', full in ~{days} d' if days is not None else ''), cap.split(';')[0] + when))
    return out


CRON_DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']


def cron_human(f):
    mi, ho, dom, mon, dow = f

    def hhmm(h, m):
        return f'{int(h):02d}:{int(m):02d}'
    if mi == '*' and ho == '*':
        return 'every minute'
    m = re.fullmatch(r'\*/(\d+)', mi)
    if m and ho == '*':
        return f'every {m.group(1)} min'
    if ho == '*' and re.fullmatch(r'[\d,]+', mi):
        return 'hourly at ' + ', '.join(':' + x.zfill(2) for x in mi.split(','))
    m = re.fullmatch(r'(\d+)-(\d+)/(\d+)', ho)
    if m and mi.isdigit():
        return f'every {m.group(3)} h, {hhmm(m.group(1), mi)}–{hhmm(m.group(2), mi)}'
    if mi.isdigit() and ho.isdigit():
        t = hhmm(ho, mi)
        if dom == '*' and dow == '*':
            return f'daily {t}'
        if dom == '*' and dow != '*':
            days = []
            for part in dow.split(','):
                if '-' in part:
                    a, b = part.split('-')
                    days.append(f'{CRON_DOW[int(a)]}–{CRON_DOW[int(b)]}')
                elif part.isdigit():
                    days.append(CRON_DOW[int(part)])
            return f'{", ".join(days)} {t}'
        if dom.isdigit() and dow == '*':
            return f'monthly on day {dom}, {t}'
    return ' '.join(f)


def job_label(cmd):
    m = re.search(r'/home/node/bin/([\w.-]+)(?:\s+([a-z][\w-]*))?', cmd)
    if m and m.group(1) not in ('tg',):
        return m.group(1) + (' ' + m.group(2) if m.group(2) else '')
    m = re.search(r'inbox/([a-z-]+)-\$\(date', cmd)
    if m:
        return f'note to inbox: {m.group(1)}'
    if cmd.startswith('find '):
        return 'cleanup (find -delete)'
    m = re.search(r'/home/node/bin/(\w[\w-]*)', cmd)
    return m.group(1) if m else cmd.split()[0]


def parse_crontab():
    txt = read_text(P('crontab'))
    jobs = []
    comment = []
    rx_job = re.compile(r'^(#\s*)?((?:[\d*/,-]+\s+){4}[\d*/,-]+)\s+(\S.*)$')
    for line in txt.splitlines():
        s = line.strip()
        if not s:
            comment = []
            continue
        m = rx_job.match(s)
        if m:
            fields = m.group(2).split()
            cmd = m.group(3)
            desc = short_desc(' '.join(comment)) if comment else ''
            job = {'schedule': ' '.join(fields), 'when': cron_human(fields), 'job': clean(job_label(cmd), 40),
                   'description': desc, 'enabled': not m.group(1)}
            prev = jobs[-1] if jobs else None
            if prev and (prev['job'], prev['description'], prev['enabled']) == (job['job'], desc, job['enabled']):
                prev['when'] += '; ' + job['when']   # same job at several times (e.g. the commute guard)
                prev['schedule'] += '; ' + job['schedule']
            else:
                jobs.append(job)
            continue
        if s.startswith('#'):
            c = s.lstrip('#').strip()
            if re.match(r'(PROPOSED|DISABLED|moved to)', c):
                continue
            comment.append(c)
        else:
            comment = []
    return jobs


def parse_agent_watch():
    rc, out, _ = run([P('bin', 'agent-watch'), 'status'], timeout=10)
    lines = out.splitlines()
    agents = []
    hdr = next((i for i, l in enumerate(lines) if l.strip().startswith('ID ') and 'STATE' in l), None)
    if hdr is None:
        return agents
    h = lines[hdr]
    cols = ['ID', 'STATE', 'RUN', 'SILENT', 'LAST', 'OWNER TAG', 'DESCRIPTION']
    pos = [h.find(c) for c in cols]
    if min(pos) < 0:
        return agents
    for l in lines[hdr + 1:]:
        if not l.strip():
            continue
        vals = [l[p:e].strip() for p, e in zip(pos, pos[1:] + [None])]
        a = dict(zip(['id', 'state', 'run', 'silent', 'last', 'owner_tag', 'description'], vals))
        a['id'] = a['id'][:8]
        a['description'] = clean(a['description'], 70)
        a['owner_tag'] = None if a['owner_tag'] in ('-', '') else clean(a['owner_tag'], 40)
        agents.append(a)
    return agents


def reminders():
    rs = read_json(P('.local', 'state', 'remind', 'reminders.json'))
    if not isinstance(rs, list):
        return None
    tags = collections.Counter()
    known = {'deadline', 'bill', 'watch', 'kk', 'guard'}
    for r in rs:
        t = (r.get('tag') or '').split(':')[0]
        tags[t if t in known else ('untagged' if not t else 'other')] += 1
    ats = sorted(r.get('at') for r in rs if r.get('at'))
    return {'total': len(rs), 'for_owner': sum(1 for r in rs if r.get('owner')),
            'for_me': sum(1 for r in rs if not r.get('owner')),
            'next_at': ats[0] if ats else None,
            'by_tag': dict(tags.most_common(8)),
            'next_7d': sum(1 for a in ats if a <= (now_local() + dt.timedelta(days=7)).strftime('%Y-%m-%d %H:%M'))}


def brain_stats():
    rc, out, _ = run(['git', '--git-dir', P('.brain.git'), 'log', '--format=%ad|%s', '--date=format-local:%Y-%m-%d %H:%M'],
                     timeout=10)
    if rc != 0:
        return None
    per = collections.Counter()
    manual = 0
    last = None
    for l in out.splitlines():
        d, _, s = l.partition('|')
        last = last or d
        per[d[:10]] += 1
        if not s.startswith('auto'):
            manual += 1
    wk = (now_local() - dt.timedelta(days=6)).strftime('%Y-%m-%d')
    return {'commits': sum(per.values()), 'manual': manual, 'last': last,
            'last_7d': sum(n for d, n in per.items() if d >= wk)}


def frontmatter(txt):
    m = re.match(r'---\s*\n(.*?)\n---', txt, re.S)
    return m.group(1) if m else ''


def is_private(txt):
    """Skills/agents marked `private: true`, `hidden: true` or `dashboard: hide` in their frontmatter stay off the page."""
    return bool(re.search(r'^(?:private|hidden):\s*(?:true|yes)\s*$|^dashboard:\s*(?:hide|hidden|no|false)\s*$',
                          frontmatter(txt), re.M | re.I))


def capabilities():
    def described(pattern, name):
        out = []
        for d in sorted(glob.glob(P('.claude', *pattern))):
            txt = read_text(d)
            m = re.search(r'^description:\s*(.+)$', txt, re.M)
            if not is_private(txt):
                out.append({'name': name(d), 'what': clean(re.split(r'(?<=[.!?])\s', m.group(1).strip() if m else '',
                                                                    maxsplit=1)[0], 110)})
        return out
    skills = described(('skills', '*', 'SKILL.md'), lambda d: os.path.basename(os.path.dirname(d)))
    agents = described(('agents', '*.md'), lambda d: os.path.basename(d)[:-3])
    return {'skills': skills, 'agents': agents}


# ---------------------------------------------------------------- codebase stats
# Test-suite line and check counts only (never file contents). Recomputed at most hourly (ASSIST_TTL), cached in
# ~/.local/state/dash/assistant-stats.json. Third-party trees (venvs, node_modules, vendor, llama.cpp, whisper.cpp)
# and anything private (~/.secrets, vault data, context, reports, nginx-mirror) are never walked.
ASSIST_CACHE = os.path.join(STATE_DIR, 'assistant-stats.json')
ASSIST_TTL = int(os.environ.get('DASH_ASSIST_TTL', '3600'))
ASSIST_VERSION = 3   # cache format: plugins, hooks, tests only (line counts: dash-growth)
LANG_EXT = {'.py': 'Python', '.sh': 'Shell', '.bash': 'Shell', '.js': 'JavaScript', '.mjs': 'JavaScript',
            '.cjs': 'JavaScript', '.ts': 'TypeScript', '.tsx': 'TypeScript', '.html': 'HTML', '.css': 'CSS'}
SKIP_DIRS = {'node_modules', '__pycache__', '.git', 'vendor', 'dist', 'build', '.venv', 'venv', 'data', 'state'}
# a "check" = one assertion line (assert / self.assertX / assert.equal / expect( / the shell+python harness helpers)
RX_CHECK = re.compile(r'^\s*(?:await\s+)?(?:(?:self\.)?assert\w*(?:\.\w+)?\s*[( ]|assert\s|(?:ok|check|eq|has|expect)\s*[( ])')
RX_SHFN = re.compile(r'^\s*\w+\s*\(\)\s*\{')


def lang_of(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in LANG_EXT:
        return LANG_EXT[ext]
    if ext:
        return None
    try:
        with open(path, 'rb') as f:
            first = f.readline(200)
    except OSError:
        return None
    if not first.startswith(b'#!'):
        return None
    if b'python' in first:
        return 'Python'
    if re.search(rb'\b(?:ba|da|z)?sh\b', first):
        return 'Shell'
    if re.search(rb'\b(?:node|bun|deno)\b', first):
        return 'JavaScript'
    return None


def file_lines(path, checks=False, seen=None):
    """(non-blank lines, test checks) of a text file; binaries, files over 2 MB and copies of a file already in
    `seen` (same bytes, e.g. the vault's copies of my tests) count as nothing."""
    try:
        if os.path.getsize(path) > 2 * 1024 * 1024:
            return 0, 0
        with open(path, 'rb') as f:
            raw = f.read()
    except OSError:
        return 0, 0
    if b'\0' in raw[:4096]:
        return 0, 0
    if seen is not None:
        hsh = hash(raw)
        if hsh in seen:
            return 0, 0
        seen.add(hsh)
    loc = nc = 0
    for l in raw.decode('utf-8', 'replace').splitlines():
        if l.strip():
            loc += 1
            if checks and RX_CHECK.match(l) and not RX_SHFN.match(l):
                nc += 1
    return loc, nc


def code_files(root, recurse=True, skip_tests=False):
    """[(path, lang)] of my code under root (no symlinks, no third-party dirs)."""
    out = []
    if os.path.isfile(root):
        lg = lang_of(root)
        return [(root, lg)] if lg else []
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS and not d.startswith('.')
                         and not (skip_tests and d in ('test', 'tests')))
        for fn in sorted(files):
            p = os.path.join(dirpath, fn)
            if os.path.islink(p) or (skip_tests and re.match(r'(test_|.*[._]test\.)', fn)):
                continue
            lg = lang_of(p)
            if lg:
                out.append((p, lg))
        if not recurse:
            break
    return out


def test_paths():
    paths = sorted(glob.glob(P('opt', '*-tests')))
    paths += [p for p in (P('opt', 'claude-vault', 'tests'),) if os.path.isdir(p)]
    paths += sorted(glob.glob(P('plugins', '*', 'test')))
    paths += sorted(glob.glob(P('.claude', 'hooks', 'test_*')))
    paths += sorted(glob.glob(P('opt', '*-src', 'test_*')))
    return [p for p in paths if not os.path.islink(p)]


def codebase_stats():
    """Plugins, hooks and the test suites (files, lines, a rough check count). Line counts of the codebase itself
    come from dash-growth (the page's one line count)."""
    plugins = sorted(d for d in os.listdir(P('plugins')) if os.path.isdir(P('plugins', d)) and not d.startswith('.')) if os.path.isdir(P('plugins')) else []
    suites = test_paths()
    t_files = t_loc = t_checks = 0
    seen = set()
    for root in suites:
        for p, _ in code_files(root, True, False):
            l, c = file_lines(p, checks=True, seen=seen)
            if l:
                t_files, t_loc, t_checks = t_files + 1, t_loc + l, t_checks + c
    hooks_ev = hooks_n = 0
    try:
        with open(P('.claude', 'settings.json')) as f:
            hk = (json.load(f) or {}).get('hooks') or {}
        hooks_ev = len(hk)
        hooks_n = sum(len(m.get('hooks') or []) for ms in hk.values() for m in ms)
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    return {
        'version': ASSIST_VERSION,
        'computed_at': time.time(),
        'computed_local': now_local().strftime('%Y-%m-%d %H:%M'),
        'plugins': {'count': len(plugins), 'names': [clean(x, 30) for x in plugins]},
        'hooks': {'events': hooks_ev, 'handlers': hooks_n},
        'tests': {'suites': len(suites), 'checks': t_checks, 'files': t_files, 'loc': t_loc},
    }


def cached_codebase_stats():
    try:
        with open(ASSIST_CACHE) as f:
            c = json.load(f)
        if c.get('version') == ASSIST_VERSION and time.time() - float(c.get('computed_at', 0)) < ASSIST_TTL:
            return c
    except (OSError, ValueError, TypeError):
        pass
    c = codebase_stats()
    try:
        atomic_write(ASSIST_CACHE, json.dumps(c, ensure_ascii=False))
    except OSError:
        pass
    return c


def redact_strings(obj):
    """One `secretscan --redact` pass over every string in obj (line-preserving); fails closed to '[redacted]'."""
    leaves = []

    def walk(o):
        if isinstance(o, dict):
            for k in o:
                if isinstance(o[k], str):
                    leaves.append((o, k))
                else:
                    walk(o[k])
        elif isinstance(o, list):
            for i, x in enumerate(o):
                if isinstance(x, str):
                    leaves.append((o, i))
                else:
                    walk(x)
    walk(obj)
    if not leaves:
        return obj
    text = '\n'.join(c[k].replace('\n', ' ').replace('\r', ' ') for c, k in leaves) + '\n'
    sc = P('bin', 'secretscan')
    try:
        r = subprocess.run([sc, '--redact'], input=text, capture_output=True, text=True, timeout=60)
        lines = r.stdout.split('\n')[:len(leaves)] if r.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired):
        lines = []
    if len(lines) != len(leaves):
        lines = ['[redacted]'] * len(leaves)
    for (c, k), v in zip(leaves, lines):
        c[k] = v
    return obj


def codebase():
    """Codebase tab: plugins, hooks, tests (cached hourly), the skill and subagent list, config snapshots (live)."""
    st = cached_codebase_stats()
    caps = capabilities()
    out = {
        'stats': {k: st.get(k) for k in ('computed_local', 'plugins', 'hooks', 'tests')},
        'skills': caps['skills'],
        'agents': caps['agents'],
        'brain': brain_stats(),
    }
    return redact_strings(out)



def status_now():
    st = {}
    try:
        with open(P('.local', 'state', 'tg-status', 'state.json')) as f:
            s = json.load(f)
        st['mode'] = s.get('mode')
        if s.get('since'):
            st['since'] = local(float(s['since'])).strftime('%H:%M')
    except (OSError, ValueError):
        pass
    rc, out, _ = run([P('bin', 'tg-status'), 'show', '--plain'], timeout=10)
    if rc == 0 and out.strip():
        st['header'] = clean(out.strip().splitlines()[0], 120)
    return st


def heartbeat_gate(now):
    """Today's heartbeat pre-check decisions (hb-gate log, counts only) and the mod's counters; None before the gate ran."""
    day, c = now.strftime('%Y-%m-%d'), {'wake': 0, 'skip': 0}
    try:
        with open(HB_GATE_LOG, encoding='utf-8') as f:
            for line in f:
                p = line.split(' ', 3)
                if len(p) > 2 and p[0] == day and p[2] in c:
                    c[p[2]] += 1
    except OSError:
        return None
    return {'wake_today': c['wake'], 'skip_today': c['skip']}


def inbox_count():
    try:
        return len([f for f in os.listdir(P('inbox')) if not f.startswith('.')])
    except OSError:
        return None


# ----------------------------------------------------------------------------------------- health
def check(name, status, value, detail=None):
    return {'name': name, 'status': status, 'value': clean(value, 120), 'detail': clean(detail, 200) if detail else None}


def health():
    out = []
    # Telegram channel
    rc, txt, _ = run([P('bin', 'channel-check'), '--status'], timeout=15)
    f = {}
    for l in txt.splitlines():
        k, _, v = l.partition(':')
        f[k.strip()] = v.strip()
    if f:
        deliv = f.get('delivery', '?')
        inc = f.get('incidents', '?')
        poll = f.get('poll role', '')
        pm = re.search(r'last getUpdates (\S+)', poll)
        last_poll = None
        if pm and iso_epoch(pm.group(1)):
            last_poll = local(iso_epoch(pm.group(1))).strftime('%H:%M')
        ok = deliv.startswith('ok') and inc == 'none'
        plugin = re.sub(r'\(.*?\)', '', f.get('plugin', '')).strip()
        out.append(check('Telegram channel', 'ok' if ok else 'warn',
                         f"delivery {deliv.split(' ')[0]}, incidents {inc}" + (f', last poll {last_poll}' if last_poll else ''),
                         f"plugin {plugin}; restarts: {f.get('restarts', '?')}"))
    else:
        out.append(check('Telegram channel', 'unknown', 'channel-check gave no status'))
    # Privacy vault
    rc, txt, _ = run([P('bin', 'vault'), 'status'], timeout=15)
    if rc == 0 and txt.strip():
        lines = txt.strip().splitlines()
        head = lines[0]
        llm = next((l.split(':', 1)[1].strip() for l in lines if l.startswith('local LLM')), '?')
        tg = next((l.split(':', 1)[1].strip() for l in lines if l.startswith('telegram:')), '?')
        alerts = re.search(r'alerts:\s*(\d+)', txt)
        pend = re.search(r'raw requests pending:\s*(\d+)', txt)
        up = re.search(r'\bup (\S+)', head)
        st = 'ok' if 'healthy' in llm and (alerts and alerts.group(1) == '0') else 'warn'
        detail = f'Telegram archive: {tg}'
        if 'not logged in' in tg:
            detail += ' (waiting on your api_id/api_hash)'
        out.append(check('Privacy vault', st, f"up {up.group(1) if up else '?'}, local LLM {llm}, alerts {alerts.group(1) if alerts else '?'}",
                         detail + (f'; raw requests pending {pend.group(1)}' if pend else '')))
    else:
        out.append(check('Privacy vault', 'critical', 'vault not reachable'))
    # Browser
    rc, txt, _ = run([P('bin', 'browser'), 'status'], timeout=15)
    cm = re.search(r'chrome:\s*Chrome/([\d.]+).*?~(\d+) MB', txt)
    view = re.search(r'^view:\s*(\S+)', txt, re.M)
    if cm:
        out.append(check('Browser', 'ok', f'Chrome {cm.group(1)}, ~{cm.group(2)} MB',
                         f"owner view {view.group(1) if view else '?'}"))
    else:
        out.append(check('Browser', 'warn' if 'stopped' not in txt else 'unknown', 'Chrome not running'))
    # Local speech model
    rc, txt, _ = run([P('bin', 'whisper-server-ctl'), 'status'], timeout=10)
    out.append(check('Voice transcription', 'ok' if txt.startswith('up') else 'warn',
                     'whisper server up' if txt.startswith('up') else 'whisper server down',
                     'runs locally on loopback; audio never leaves the container'))
    # Backups
    log = read_text(P('.local', 'state', 'brain-backup.log')).strip().splitlines()
    fails = sorted(glob.glob(P('inbox', 'brain-backup-failed-*')))
    if fails:
        out.append(check('Nightly backup', 'critical', 'last run failed', 'see the inbox note'))
    elif log:
        m = re.search(r'(\d+)\s+(\w{3}\s+\d+\s+[\d:]+)\s+\S*claude-bot-(\d{4}-\d\d-\d\d)', log[-1])
        size = re.search(r'\s(\d{4,})\s+\w{3}\s+\d', log[-1])
        when = m.group(3) if m else 'unknown'
        age_ok = m and (now_local().date() - dt.date.fromisoformat(m.group(3))).days <= 1
        out.append(check('Nightly backup', 'ok' if age_ok else 'warn', f'last archive {when}',
                         (f'{int(size.group(1)) / 1e6:.0f} MB, ' if size else '') + 'Unraid share, 14 days kept'))
    else:
        out.append(check('Nightly backup', 'unknown', 'no run logged yet', 'scheduled daily 03:47 (set up 2026-10-10)'))
    # Brain snapshots
    rc, txt, _ = run(['git', '--git-dir', P('.brain.git'), 'log', '-1', '--format=%ct'], timeout=10)
    if rc == 0 and txt.strip().isdigit():
        age = time.time() - int(txt.strip())
        out.append(check('Config snapshots', 'ok' if age < 6 * 3600 else 'warn', f'last {human_dur(age)} ago',
                         'brain repo, auto every 30 min when something changed'))
    # Subagents
    agents = parse_agent_watch()
    stalled = [a for a in agents if a.get('state') == 'stalled']
    out.append(check('Background agents', 'warn' if stalled else 'ok',
                     f"{sum(1 for a in agents if a.get('state') == 'running')} running, {len(stalled)} stalled"))
    # Inbox backlog
    n = inbox_count()
    if n is not None:
        out.append(check('Inbox backlog', 'ok' if n <= 5 else 'warn', f'{n} note(s) waiting'))
    # Cron daemon
    rc, txt, _ = run(['pgrep', '-x', 'cron'], timeout=5)
    out.append(check('Cron daemon', 'ok' if rc == 0 else 'critical', 'running' if rc == 0 else 'not running'))
    # Disk
    du = shutil.disk_usage(HOME)
    pct = du.used / du.total * 100
    rc, txt, _ = run(['du', '-sb', HOME], timeout=30)
    home_b = int(txt.split()[0]) if rc == 0 and txt.split() else None
    out.append(check('Disk', 'ok' if pct < 85 else ('warn' if pct < 95 else 'critical'),
                     f'{pct:.0f}% used, {du.free / 1e9:.0f} GB free',
                     (f'/home/node holds {home_b / 1e9:.1f} GB' if home_b else None)))
    # Memory (cgroup if limited, else host)
    mem = None
    try:
        cur = int(read_text('/sys/fs/cgroup/memory.current').strip())
        mx = read_text('/sys/fs/cgroup/memory.max').strip()
        mem = (cur, int(mx) if mx.isdigit() else None)
    except ValueError:
        pass
    mi = {}
    for l in read_text('/proc/meminfo').splitlines():
        k, _, v = l.partition(':')
        mi[k] = int(v.split()[0]) * 1024 if v.split() else 0
    if mem and mem[1]:
        p = mem[0] / mem[1] * 100
        out.append(check('Memory', 'ok' if p < 85 else 'warn', f'{mem[0] / 1e9:.1f} of {mem[1] / 1e9:.0f} GB container limit'))
    elif mem:
        out.append(check('Memory', 'ok', f'{mem[0] / 1e9:.1f} GB used by the container',
                         f"host: {mi.get('MemAvailable', 0) / 1e9:.0f} of {mi.get('MemTotal', 0) / 1e9:.0f} GB available"))
    # Load
    la = os.getloadavg()
    cpus = os.cpu_count() or 1
    out.append(check('CPU load', 'ok' if la[1] < cpus * 0.8 else 'warn', f'{la[0]:.1f} / {la[1]:.1f} / {la[2]:.1f}',
                     f'{cpus} CPU threads (1, 5, 15 min averages)'))
    # Uptime
    rc, txt, _ = run(['ps', '-o', 'etimes=', '-p', '1'], timeout=5)
    cup = int(txt.strip()) if txt.strip().isdigit() else None
    hup = float(read_text('/proc/uptime').split()[0]) if read_text('/proc/uptime') else None
    out.append(check('Uptime', 'ok', f'container {human_dur(cup) if cup else "?"}',
                     f'host (Unraid) {human_dur(hup)}' if hup else None))
    out[:0] = server_checks()   # the server first: the Today card lists problems in this order
    summary = collections.Counter(c['status'] for c in out)
    return {'checks': out, 'summary': dict(summary)}


# ----------------------------------------------------------------------------------------- data map
def dir_size(path):
    total = 0
    files = 0
    for root, dirs, fs in os.walk(path):
        for f in fs:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
                files += 1
            except OSError:
                pass
    return total, files


def dataflow():
    try:
        with open(DATAFLOW) as f:
            df = json.load(f)
    except (OSError, ValueError) as e:
        return {'error': f'data map missing or invalid: {type(e).__name__}'}
    for s in df.get('stores', []):
        paths = s.pop('paths', None)
        count_only = s.pop('count_only', False)
        if paths:
            sizes = [dir_size(os.path.expanduser(p)) for p in paths]
            b, n = sum(x[0] for x in sizes), sum(x[1] for x in sizes)
            s['live'] = {'files': n} if count_only else {'bytes': b, 'files': n}
    for k in ('version', 'sensitivity_levels', 'routes', 'edge_labels', 'viewbox'):
        df.pop(k, None)
    df['nodes'] = [{k: n[k] for k in ('id', 'label', 'sub', 'group') if k in n} for n in df.get('nodes', [])]
    df['live'] = vault_live()
    if isinstance(df['live'], dict):
        df['live'].pop('calls_24h', None)   # older cached copies
    return df


# Live privacy-vault numbers for the Data tab: COUNTS ONLY. The audit log also holds free text (raw-request
# queries and reasons); only `event` and `ts` are read here, nothing else is copied.
VAULT = os.environ.get('DASH_VAULT', 'vault')
VAULT_CACHE = os.path.join(STATE_DIR, 'vault-live.json')
VAULT_TTL = int(os.environ.get('DASH_VAULT_TTL', '1800'))   # dash-publish runs every 5 min; ask the vault every 30
READ_SOURCES = ('telegram', 'mail', 'documents', 'finance', 'search')
READ_EVENTS = {
    'tg_search': 'telegram', 'tg_recent': 'telegram', 'tg_summarize': 'telegram', 'tg_facts_read': 'telegram',
    'tg_window': 'telegram', 'tg_who': 'telegram', 'tg_find_chat': 'telegram',
    'gmail_search': 'mail', 'gmail_get': 'mail',
    'paperless_search': 'documents', 'paperless_get': 'documents', 'paperless_recent': 'documents',
    'paperless_fields': 'documents',
    'find': 'search', 'facts': 'search',
}


def read_source(event):
    """Which private source an audit event read content from (None = status, write, admin or job event)."""
    if event in READ_EVENTS:
        return READ_EVENTS[event]
    if event.startswith(('firefly_', 'finance_')) and not event.endswith(('_refused', '_status', '_failed')):
        return 'finance'
    return None


def vault_live():
    cached = read_json(VAULT_CACHE)
    if isinstance(cached, dict) and VAULT_TTL > 0 and 0 <= time.time() - cached.get('_at', 0) < VAULT_TTL:
        cached.pop('_at', None)
        return cached
    rc, out, _ = run([VAULT, 'audit', '--days', '8', '--json'], timeout=20)
    try:
        audit = json.loads(out) if rc == 0 else None
    except ValueError:
        audit = None
    if not isinstance(audit, list):
        return {'error': 'privacy vault not reachable'}

    def jrun(*args):
        rc, out, _ = run([VAULT, *args, '--json'], timeout=20)
        try:
            v = json.loads(out) if rc == 0 else None
        except ValueError:
            v = None
        return v if isinstance(v, dict) else {}
    st, mt = jrun('status'), jrun('metrics')
    now = now_local()
    today = now.date()
    days = [today - dt.timedelta(days=i) for i in range(6, -1, -1)]
    daily = {d: 0 for d in days}
    by24 = collections.Counter()
    raw_rel = raw_test = 0
    first = None
    cut24, cut7 = now - dt.timedelta(hours=24), now - dt.timedelta(days=7)
    for e in audit:
        if not isinstance(e, dict):
            continue
        try:
            ts = dt.datetime.fromisoformat(str(e.get('ts', ''))).astimezone(TZ)
        except (TypeError, ValueError):
            continue
        first = ts if first is None or ts < first else first
        ev = str(e.get('event', ''))
        if ev == 'raw_released' and ts >= cut7:
            if e.get('source') == 'test':
                raw_test += 1
            else:
                raw_rel += 1
        src = read_source(ev)
        if not src:
            continue
        if ts.date() in daily:
            daily[ts.date()] += 1
        if ts >= cut24:
            by24[src] += 1
    first_day = first.date() if first else today
    series = [{'date': d.isoformat(), 'label': d.strftime('%a'), 'n': daily[d] if d >= first_day else None,
               'today': d == today} for d in days]
    # 7-day average over complete days only (not today, not the vault's first, partial day)
    full = [x['n'] for x in series if not x['today'] and x['n'] is not None and x['date'] > first_day.isoformat()]
    llm = st.get('llm') or {}
    m = re.match(r'([A-Za-z]+)-(\d+(?:\.\d+)?)-(\d+B)', str(llm.get('model') or ''))
    pol = re.search(r'v(\d+(?:\.\d+)*)', str((st.get('vault') or {}).get('policy') or ''))
    tg, gm = st.get('tg') or {}, st.get('gmail') or {}
    n_acc = len(gm.get('accounts') or []) or (1 if gm.get('configured') else 0)
    sources = [
        {'name': 'Telegram', 'ok': bool(tg.get('logged_in')),
         'note': 'live' if (tg.get('live') or {}).get('state') == 'running' else ('synced' if tg.get('logged_in') else 'not logged in')},
        {'name': 'Gmail', 'ok': bool(gm.get('configured')) and not gm.get('error'),
         'note': f"{n_acc} account{'s' if n_acc != 1 else ''}" if gm.get('configured') else 'not set up'},
        {'name': 'paperless', 'ok': bool((st.get('paperless') or {}).get('configured')), 'note': 'documents'},
        {'name': 'Firefly', 'ok': bool((st.get('firefly') or {}).get('configured')), 'note': 'finances'},
    ]
    routes = [r for r in (mt.get('routes') or []) if isinstance(r, dict)]
    alerts = st.get('alerts')
    res = {
        'as_of': now.strftime('%H:%M'),
        'reads_24h': sum(by24.values()),
        'reads_24h_by': {k: by24.get(k, 0) for k in READ_SOURCES},
        'reads_daily': series,
        'reads_avg': round(sum(full) / len(full), 1) if full else None,
        'raw_released_7d': raw_rel,
        'raw_tests_7d': raw_test,
        'raw_pending': int((st.get('raw') or {}).get('pending') or 0),
        'alerts': alerts if isinstance(alerts, int) else None,
        'llm_ok': bool(llm.get('healthy')) if st else None,
        'llm': f'{m.group(1).capitalize()} {m.group(2)} {m.group(3)}' if m else 'local LLM',
        'policy': ('v' + pol.group(1)) if pol else None,
        'errors_24h': sum(int(r.get('errors') or 0) for r in routes) if routes else None,
        'sources': sources if st else [],
    }
    try:
        atomic_write(VAULT_CACHE, json.dumps(dict(res, _at=time.time())))
    except OSError:
        pass
    return res


# ----------------------------------------------------------------------------------------- assemble
def build(use_cache=True):
    t0 = time.time()
    now = now_local()
    tokens = collect_tokens(use_cache)
    timeline = tokens.pop('timeline')
    todo = parse_todo()
    agents = parse_agent_watch()
    hl = health()
    data = {
        'schema': 1,
        'title': 'Claude Bot Dashboard',
        'generated_at': now.isoformat(timespec='seconds'),
        'generated_local': now.strftime('%Y-%m-%d %H:%M'),
        'tz': 'Europe/Zurich',
        'now': status_now(),
        'tokens': tokens,
        'activity': {
            'todo': {'due': todo['due'], 'in_progress': todo['in_progress'], 'waiting': todo['waiting'],
                     'ideas_count': len(todo['ideas'])},
            'agents': agents,
            'changelog': parse_log(os.path.join(WORKSPACE, 'CHANGELOG.md')),
            'cron': parse_crontab(),
            'reminders': reminders(),
            'heartbeat': heartbeat_gate(now),
            'timeline': timeline,
            'dayline': dayline(),
        },
        'goals': parse_goals(),
        'context': context_card(),
        'health': hl,
        'dataflow': dataflow(),
        'codebase': codebase(),
        'growth': growth(tokens['daily']),
    }
    # log-derived lines last: names and amounts out (scrub), judged against what the rest of the page shows
    shown = shown_words(data, LOG_BLOCKS)
    act = data['activity']
    for k in ('changelog', 'dayline'):
        act[k] = scrub_tree(act[k], shown)
    act['lastnight'] = lastnight(shown, now)
    data['build_seconds'] = round(time.time() - t0, 2)
    return data


LOG_BLOCKS = {('activity', 'changelog'), ('activity', 'dayline'), ('activity', 'lastnight')}


GROWTH = os.environ.get('DASH_GROWTH', P('.local', 'state', 'dash-growth.json'))
GROWTH_BIN = os.environ.get('DASH_GROWTH_BIN', P('bin', 'dash-growth'))


def growth(daily=()):
    """Codebase tab charts + tiles: daily points of my codebase from ~/bin/dash-growth, which this
    refreshes at most hourly (it backfills from git with --backfill). Numbers and dates only; labels are dash-growth's
    own constants. `daily` = this run's tokens.daily: today's activity point comes from it (dash-growth copies the
    previous run's, which lags)."""
    if GROWTH_BIN and os.access(GROWTH_BIN, os.X_OK):
        run([GROWTH_BIN, '--if-stale', '55'], timeout=90)
    g = read_json(GROWTH, {}) or {}
    if not isinstance(g, dict):
        return None

    def num(x):
        return x if isinstance(x, (int, float)) and not isinstance(x, bool) else None

    def nums(o, keys):
        o = o if isinstance(o, dict) else {}
        return {k: num(o.get(k)) or 0 for k in keys}

    parts = [{'key': clean(str(x.get('key', '')), 20), 'label': clean(str(x.get('label', '')), 40)}
             for x in (g.get('parts') or []) if isinstance(x, dict)]
    keys = [x['key'] for x in parts]
    rx_date = re.compile(r'^\d{4}-\d{2}-\d{2}$')
    days = []
    for d in g.get('days') or []:
        if not isinstance(d, dict) or not rx_date.match(str(d.get('date', ''))):
            continue
        days.append({'date': d['date'], 'live': d.get('source') == 'live', 'loc_total': num(d.get('loc_total')) or 0,
                     'loc': nums(d.get('loc'), keys),
                     'counts': nums(d.get('counts'), ('scripts', 'skills', 'agents', 'cron')),
                     'claude_md_kb': num(d.get('claude_md_kb'))})
    act = dict(g.get('activity')) if isinstance(g.get('activity'), dict) else {}
    for d in daily or []:   # same definitions as dash-growth: owner messages = Telegram + app/terminal
        t = d.get('turns') or {}
        act[d['date']] = {'heartbeats': t.get('heartbeat', 0), 'owner_msgs': t.get('telegram', 0) + t.get('you (app/terminal)', 0),
                          'subagents': d.get('subagent_runs', 0)}
    activity = [dict({'date': k}, **nums(v, ('heartbeats', 'owner_msgs', 'subagents')))
                for k, v in sorted(act.items()) if rx_date.match(str(k))]
    if not days:
        return None
    last = (g.get('days') or [{}])[-1] if isinstance((g.get('days') or [{}])[-1], dict) else {}
    langs = last.get('langs') if isinstance(last.get('langs'), dict) else {}
    return {'updated': clean(str(g.get('updated', '')), 20), 'parts': parts, 'days': days, 'activity': activity,
            'langs': [{'lang': clean(str(k), 30), 'loc': num(v) or 0} for k, v in langs.items() if num(v)],
            'files': nums(last.get('files'), keys)}


def secret_check(text):
    sc = P('bin', 'secretscan')
    if not os.path.exists(sc):
        return True, 'secretscan missing'
    try:
        r = subprocess.run([sc, '--stdin', '-q'], input=text, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)
    return r.returncode == 0, (r.stdout + r.stderr).strip()


def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.' + os.path.basename(path))
    with os.fdopen(fd, 'w') as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


RX_DATA_BLOCK = re.compile(r'(<script id="dash-data" type="application/json"[^>]*>)(.*?)(</script>)', re.S)


def embed(page, payload, mode):
    def rep(m):
        tag = re.sub(r'data-mode="[^"]*"', f'data-mode="{mode}"', m.group(1))
        return tag + payload + m.group(3)
    new, n = RX_DATA_BLOCK.subn(rep, page, count=1)
    if n != 1:
        raise SystemExit('dash-data: no <script id="dash-data"> block in the page')
    return new


RX_PROFILE_TOKEN = re.compile(r'\{\{([a-z_]+(?:\.[a-z_]+)+)\}\}')


def fill_profile(page):
    """{{key}} in the template -> the profile value (HTML-escaped), only for PAGE_PROFILE_KEYS; other tokens stay."""
    keys = set(RX_PROFILE_TOKEN.findall(page)) & set(PAGE_PROFILE_KEYS)
    if not keys:
        return page
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), 'lib'))
    import assistant_profile
    vals = {k: html.escape(str(assistant_profile.get(k))) for k in keys}
    return RX_PROFILE_TOKEN.sub(lambda m: vals.get(m.group(1), m.group(0)), page)


def artifact_fragment(page):
    """Page without doctype/html/head/body: the claude.ai Artifact skeleton adds those."""
    head = re.search(r'<!--dash:head-->(.*?)<!--/dash:head-->', page, re.S)
    body = re.search(r'<!--dash:body-->(.*?)<!--/dash:body-->', page, re.S)
    if not head or not body:
        raise SystemExit('dash-data: page is missing the dash:head/dash:body markers')
    return head.group(1).strip() + '\n' + body.group(1).strip() + '\n'


def main():
    ap = argparse.ArgumentParser(description='Collect data for the Claude Bot Dashboard.')
    ap.add_argument('--inline', action='store_true', help='also write www/dashboard.html with the data embedded')
    ap.add_argument('--stdout', action='store_true', help='print the JSON, write nothing')
    ap.add_argument('--no-cache', action='store_true', help='re-parse every transcript')
    ap.add_argument('--out', help='write data.json here instead')
    a = ap.parse_args()

    data = build(use_cache=not a.no_cache)
    text = json.dumps(data, ensure_ascii=False, indent=1)
    ok, why = secret_check(text)
    if not ok:
        print('dash-data: secretscan flagged the output, nothing written: ' + why, file=sys.stderr)
        sys.exit(3)
    if a.stdout:
        print(text)
        return
    out = a.out or OUT
    atomic_write(out, text + '\n')
    if a.out:
        print(out)
        return
    atomic_write(os.path.join(WWW_DIR, 'data.json'), text + '\n')
    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).replace('</', '<\\/')
    page = read_text(INDEX)   # the template is only read, never written
    if page:
        page = fill_profile(page)
        atomic_write(os.path.join(WWW_DIR, 'index.html'), embed(page, payload, 'fallback'))
        if a.inline:
            atomic_write(INLINE_OUT, artifact_fragment(embed(page, payload, 'inline')))
    elif a.inline:
        raise SystemExit(f'dash-data: {INDEX} missing, cannot build dashboard.html')
    t = data['tokens']
    print(f"dash-data: {out} ({len(text) / 1024:.0f} KB, {data['build_seconds']} s): "
          f"{t['totals']['tokens'] / 1e6:.1f}M tokens, est. ${t['totals']['cost_usd']:.2f} list price, "
          f"{t['runs_total']} agent/worker runs" + (f'; {INLINE_OUT}' if a.inline and page else ''))


if __name__ == '__main__':
    main()

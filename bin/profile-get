#!/usr/bin/python3 -I
"""profile-get: read one value from the owner's profile (~/.config/assistant/profile.json) for shell scripts.

  profile-get KEY            print the value: strings as they are, numbers/lists/objects as compact JSON
  profile-get KEY --hash     sha256 of exactly what KEY prints (no newline): compare a value without showing it
  profile-get --keys         every key, one per line (names only, never values)
  profile-get --source       the profile file in use, or "defaults" when there is none
  profile-get --check        validate the file: types and unknown keys (names only); exit 1 on a problem

KEY is dotted: home.town, network.lan_prefix, network.hosts.web_vm. Missing file: the public placeholder
defaults (bin/lib/assistant_profile.py). $ASSISTANT_PROFILE points to another file (tests use a fixture).
Exit: 0 ok, 1 profile unreadable/invalid, 2 unknown key or bad usage.
Example: town=$(profile-get home.town) || exit 1
"""
import hashlib
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import assistant_profile as profile  # noqa: E402


def main(argv):
    flags = {a for a in argv if a.startswith("-")}
    args = [a for a in argv if not a.startswith("-")]
    if "-h" in flags or "--help" in flags or (not args and not flags & {"--keys", "--source", "--check"}):
        print(__doc__.strip(), file=sys.stdout if flags & {"-h", "--help"} else sys.stderr)
        return 0 if flags & {"-h", "--help"} else 2
    bad = flags - {"--hash", "--keys", "--source", "--check"}
    if bad or len(args) > 1:
        print("profile-get: bad usage (see --help)", file=sys.stderr)
        return 2
    try:
        if "--source" in flags:
            print(profile.source() or "defaults")
            return 0
        if "--keys" in flags:
            print("\n".join(profile.keys()))
            return 0
        if "--check" in flags:
            src = profile.source()
            unk = profile.unknown_keys()
            for k in unk:
                print("profile-get: unknown key %s (not in the defaults: typo?)" % k, file=sys.stderr)
            if src:
                mode = os.stat(src).st_mode & 0o777
                if mode & 0o077:
                    print("profile-get: %s is mode %o, want 600" % (src, mode), file=sys.stderr)
                    return 1
            print("profile-get: ok (%s, %d keys%s)" % (src or "defaults", len(profile.keys()),
                                                      ", %d unknown" % len(unk) if unk else ""))
            return 0
        try:
            v = profile.get(args[0])
        except KeyError:
            print("profile-get: unknown key %s" % args[0], file=sys.stderr)
            return 2
    except profile.ProfileError as e:
        print("profile-get: %s" % e, file=sys.stderr)
        return 1
    text = profile.as_text(v)
    if "--hash" in flags:
        print(hashlib.sha256(text.encode("utf-8")).hexdigest())
    else:
        print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/bin/sh
# Restart the main session AND wake it as soon as it's back (shadows /usr/local/bin/restart via PATH):
#   restart "why"
# The image's restart only respawns the tmux pane; the new session then sits idle until the
# 5-min heartbeat cron notices the inbox note (up to ~8 min). This adds a detached waker that
# types a [heartbeat] into the pane once the new session reports idle, like the heartbeat does.
reason="${*:-no reason given}"
# test seams (~/opt/restart-tests): the image's restart and the heartbeat marker the image's heartbeat cron reads
"${RESTART_REAL:-/usr/local/bin/restart}" "$reason" || exit
log=~/.local/state/restart-wake.log
mkdir -p "$(dirname "$log")"
setsid -f sh -c '
  reason=$(printf "%s" "$1" | tr "\n\r" "  "); log="$2"; marker="$3"   # one line: a newline typed with -l would submit early
  sleep 15
  state() { claude agents --json 2>/dev/null | jq -r --arg cwd "$HOME/workspace" "first(.[] | select(.cwd == \$cwd)) | \"\(.status) \(.waitingFor // \"\")\""; }
  i=0
  while [ $i -lt 120 ]; do            # up to ~10 min
    s=$(state)
    case $s in
      idle*)
        tmux send-keys -t claude:main -l "[heartbeat] Just restarted (${reason}). Run your heartbeat routine; if the owner is waiting on this restart, confirm on Telegram."
        sleep 1
        case $(state) in waiting*) ;; *) tmux send-keys -t claude:main Enter ;; esac
        touch "$marker"               # so the regular heartbeat skips the restart note
        echo "$(date "+%F %T") woke session after restart: $reason" >> "$log"
        exit 0 ;;
      waiting*)
        echo "$(date "+%F %T") session waiting on a dialog after restart: $s" >> "$log"
        exit 0 ;;                     # never type into a dialog; the heartbeat script alerts the owner
    esac
    i=$((i + 1)); sleep 5
  done
  echo "$(date "+%F %T") gave up waiting for idle after restart: $reason (last state: $s)" >> "$log"
' waker "$reason" "$log" "${RESTART_MARKER:-/tmp/heartbeat}"

import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

sys.dont_write_bytecode = True
HOME = os.path.expanduser('~')
CONF = os.path.join(HOME, '.config', 'vault')
SRC = os.path.join(HOME, 'opt', 'claude-vault')
STAGE = os.path.join(HOME, '.cache', 'vault', 'stage')
REMOTE = '/mnt/user/appdata/claude-vault'
SSH = os.environ.get('VAULT_SSH_HOST', 'unraid')
VOL = 'claude-vault_data'
# Local LLM weights (Gemma-4-26B-A4B, 14 GB): not in the vault's docker volume (docker.img is 50 GB, the
# owner's Unraid warns at 70%) but on the data pool, bind-mounted read-only at /models (docker-compose.yml). `deploy`
# seeds the dir: a reflink copy (same btrfs pool: instant, no extra space) of this container's ~/opt/llm-models/<file>,
# else a download; sha256-checked before it goes live. Names, hashes and URLs come from app/vaultd.py (weight_pins).
WEIGHTS_HOST = '/mnt/data/appdata/claude-vault-models'
WEIGHTS_SRC = '/mnt/data/appdata/claude-bot/home/opt/llm-models'     # = ~/opt/llm-models here
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
LONG = 4 * 3600
INSTANCE = {'prod': ('http://claude-vault:8300', os.path.join(HOME, '.secrets', 'vault-token')),
            'test': ('http://claude-vault-test:8300', os.path.join(HOME, '.secrets', 'vault-test-token'))}
EXIT_CODE_PENDING = 10
EXIT_CODE_RUNNING = 12
JOB_DIR = os.path.join(HOME, '.cache', 'vault', 'jobs')
JOB_ROUTES = {('POST', '/tg/search'): 'tg.search', ('POST', '/tg/recent'): 'tg.recent',      # vault --async (#4)
              ('POST', '/tg/unread-summary-data'): 'tg.unread-summary-data', ('POST', '/tg/summarize'): 'tg.summarize',
              ('POST', '/gmail/search'): 'gmail.search', ('POST', '/gmail/get'): 'gmail.get',
              ('POST', '/paperless/get'): 'paperless.get', ('POST', '/media/extract'): 'media.extract',
              ('POST', '/paperless/suggest'): 'paperless.suggest',
              ('POST', '/llm/run'): 'llm.run', ('POST', '/tg/facts'): 'tg.facts', ('POST', '/gmail/facts'): 'gmail.facts',
              ('POST', '/find'): 'find', ('POST', '/answer'): 'answer', ('POST', '/tg/digest'): 'tg.digest'}
HTTP_EXIT = {400: 2, 401: 77, 404: 2, 409: 1, 410: 1, 413: 2, 429: 75, 502: 3, 503: 3}


def http_exit(status, code=None):
    return 75 if code == 'llm_busy' else HTTP_EXIT.get(status, 1)


def die(msg, code=1):
    print(f'vault: {msg}', file=sys.stderr)
    sys.exit(code)


def read_file(p):
    try:
        with open(p, encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        return ''


class Client:
    async_mode = False                                 # vault --async: job-capable calls become POST /jobs
    async_argv = None

    def __init__(self, instance='prod'):
        url, tok = INSTANCE[instance]
        if instance == 'prod':
            url = os.environ.get('VAULT_URL') or read_file(os.path.join(CONF, 'url')) or url
            tok = os.environ.get('VAULT_TOKEN_FILE') or tok
        self.url, self.token_file = url.rstrip('/'), tok

    def token(self):
        try:
            st = os.stat(self.token_file)
        except FileNotFoundError:
            die(f'no API token at {self.token_file} (run: vault admin init)', 77)
        if st.st_mode & 0o077:
            os.chmod(self.token_file, 0o600)
        return read_file(self.token_file)

    def queue_watch(self, done):
        """Long calls: after 10 s, one stderr line whenever the LLM queue picture changes, e.g.
        "vault: LLM busy with tgread summarize for 2m10s (ETA ~1m), 1 queued". Kinds and times only."""
        last = None
        if done.wait(10):
            return
        while True:
            try:
                req = urllib.request.Request(self.url + '/status', headers={'Authorization': f'Bearer {self.token()}'})
                with OPENER.open(req, timeout=10) as r:
                    q = (json.loads(r.read() or b'{}').get('llm') or {}).get('queue') or {}
            except (OSError, ValueError):
                q = {}
            run, waiting = q.get('running'), q.get('queue') or []
            if run:
                fm = lambda s: f'{s // 60}m{s % 60:02d}s' if s >= 60 else f'{s}s'      # noqa: E731
                eta = f", ETA ~{fm(run['eta_s'])}" if run.get('eta_s') is not None else ''
                line = (f"vault: LLM busy with {run.get('what')} for {fm(int(run.get('elapsed_s') or 0))}{eta}"
                        + (f", {len(waiting)} queued" if waiting else ''))
                if line.split(' for ')[0] + str(len(waiting)) != last:
                    print(line, file=sys.stderr, flush=True)
                    last = line.split(' for ')[0] + str(len(waiting))
            if done.wait(15):
                return

    def submit_job(self, op, body):
        """vault --async: the call as a job (POST /jobs); prints its id (stdout) and how to wait (stderr); exit 0."""
        self.async_mode = False
        j = self.call('POST', '/jobs', {'op': op, 'params': body or {}}, timeout=60)
        if (op.split('.')[0] in ('gmail', 'paperless', 'media') or op in ('tg.facts', 'find')) \
                and self.async_argv:                   # `job wait` re-runs its printer
            try:
                write_private(os.path.join(JOB_DIR, j['id'] + '.json'),
                              json.dumps({'id': j['id'], 'op': op, 'argv': self.async_argv, 'at': time.time()}))
            except OSError:
                pass
        eta = f", ETA ~{fmt_secs(j['eta_s'])}" if j.get('eta_s') is not None else ''
        pos = f"position {j['position']}" if j.get('position') else j.get('state', 'queued')
        print(j['id'])
        print(f"vault: job {j['id']} {'joined (same request already running)' if j.get('coalesced') else 'started'}"
              f" ({pos}{eta}). Wait: vault job wait {j['id']} [--max 230]  (exit 12 = still running)",
              file=sys.stderr)
        sys.exit(0)

    def call(self, method, path, body=None, timeout=60, ok_codes=(), raise_timeout=False):
        """raise_timeout: a socket timeout raises TimeoutError (release polls end with exit 10, not exit 3)."""
        if self.async_mode:
            op = JOB_ROUTES.get((method, path))
            if op is None:
                die(f'--async is not available here ({method} {path}); it works for tg search|recent|'
                    f'unread-summary-data|summarize, gmail search|get, paperless get, media facts, facts, find and '
                    f'llm-run', 2)
            self.submit_job(op, body)
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method=method,
                                     headers={'Authorization': f'Bearer {self.token()}',
                                              'Content-Type': 'application/json'})
        done = threading.Event()
        if timeout >= 120 and os.environ.get('VAULT_QUIET') != '1':
            threading.Thread(target=self.queue_watch, args=(done,), daemon=True).start()
        try:
            with OPENER.open(req, timeout=timeout) as r:
                return json.loads(r.read() or b'{}')
        except urllib.error.HTTPError as e:
            try:
                d = json.loads(e.read() or b'{}')
            except ValueError:
                d = {}
            if e.code in ok_codes:
                return d
            die(d.get('error') or f'HTTP {e.code}', http_exit(e.code, d.get('code')))
        except (urllib.error.URLError, OSError) as e:
            reason = getattr(e, 'reason', e)
            if raise_timeout and isinstance(reason, TimeoutError):
                raise TimeoutError(str(reason)) from None
            die(f'cannot reach the vault at {self.url} ({reason}). Check: vault admin ps', 3)
        finally:
            done.set()


def release_poll(c, route, body, wait=100, no_wait=False, slack=5):
    """Poll /raw/release or /media/release until released or `wait` s are over (a release once hung past
    its 100 s and an outer 15 s timeout killed it). Each call long-polls at most the time that is left (<= 25 s)
    and its HTTP timeout is that + `slack` s, so the command ends within ~5 s of --wait even if the vault is slow
    (media: slack 1800, its Facts-only answer is made after the release, by the local LLM).
    -> the released answer, or (None, last pending answer or {}) when time is up."""
    deadline = time.monotonic() + (0 if no_wait else min(max(wait, 0), 3600))
    w, told, r = 0, None, {}
    while True:
        try:
            r = c.call('POST', route, dict(body, wait=w), timeout=w + slack, raise_timeout=True)
        except TimeoutError:
            return None, dict(r, status='pending', vault_slow=True)
        if r.get('status') != 'pending':
            return r, None
        left = deadline - time.monotonic()
        if left < 0.5:
            return None, r
        state = ('approved; the vault is still preparing the text' if r.get('approved') else
                 "waiting for his tap on ✅ Allow once / ❌ Deny" if r.get('approval') == 'buttons' else
                 'waiting for his console approval (or the CODE from his message)')
        if r.get('preparing') and not r.get('approved'):
            state += ' (the text is still being prepared)'
        if state != told:
            print(f'{state} ... (up to {int(left)} s more; --wait S)', file=sys.stderr)
            told = state
        w = max(1, min(25, int(left)))


def pending_line(kind, rid, r, again):
    """The stderr line for exit 10: pending / preparing / approved-preparing / the vault was slow."""
    exp = (r.get('expires_at') or '?')[11:16]
    if r.get('vault_slow'):
        why = 'the vault did not answer in time'
    elif r.get('approved'):
        why = 'approved; the vault is still preparing the text'
    elif r.get('preparing'):
        why = f"the owner hasn't decided yet; the text is still being prepared (expires {exp})"
    else:
        why = f"the owner hasn't decided yet (expires {exp})"
    return f'{kind} {rid}: {why}; ask again: {again}'


def fmt_secs(s):
    s = int(s or 0)
    return f'{s // 60}m{s % 60:02d}s' if s >= 60 else f'{s}s'


class ReplayClient(Client):
    """`vault job wait`: the finished job's answer fed to the command that submitted it (same output, same exit code);
    any other call goes to the vault as usual."""

    def __init__(self, base, route, job):
        self.__dict__.update(base.__dict__)
        self.route, self.job, self.async_mode = route, job, False

    def call(self, method, path, body=None, timeout=60, ok_codes=()):
        if (method, path) != self.route:
            return super().call(method, path, body, timeout, ok_codes)
        j = self.job
        if j.get('state') == 'done':
            return j.get('result') or {}
        err = j.get('error') or {}
        if j.get('status') in ok_codes:
            return err
        die(err.get('error') or f"job {j.get('state')}", http_exit(j.get('status'), err.get('code')))


def job_line(j):
    p = j.get('progress') or {}
    bits = [j.get('state', '?')]
    if p.get('total'):
        bits.append(f"{p.get('done', 0)}/{p['total']} parts" + (f" ({p['step']})" if p.get('step') else ''))
    elif p.get('step'):
        bits.append(p['step'])
    bits.append(fmt_secs(j.get('elapsed_s')))
    if j.get('position'):
        bits.append(f"LLM queue position {j['position']}")
    if j.get('eta_s') is not None and j.get('state') in ('queued', 'running'):
        bits.append(f"ETA ~{fmt_secs(j['eta_s'])}")
    return ', '.join(bits)


def print_partial(j):
    for x in j.get('partial') or []:
        print(f"## Part {x.get('part')}/{x.get('of')} ({x.get('label')}, {x.get('msgs')} message(s))\n{x.get('text', '')}\n")


def cmd_job(c, argv):
    """Async jobs: wait for one (exit 12 while it runs), list, cancel."""
    p = argparse.ArgumentParser(prog='vault job', description='async jobs in the vault (vault --async ...)')
    sp = p.add_subparsers(dest='cmd', required=True)
    w = sp.add_parser('wait', help="the job's answer, printed like its command; exit 12 = still running")
    w.add_argument('id')
    w.add_argument('--max', type=float, default=230, help='give up after this many seconds (default 230)')
    w.add_argument('--partial', action='store_true', help='still running: print the parts done so far')
    w.add_argument('--json', action='store_true', help='the job as JSON (state, progress, partial, result)')
    li = sp.add_parser('list')
    li.add_argument('--json', action='store_true')
    ca = sp.add_parser('cancel')
    ca.add_argument('id')
    a = p.parse_args(argv)
    if getattr(a, 'id', None) is not None and not re.fullmatch(r'[0-9a-f]{16}', a.id):
        die('a job id is 16 hex characters (vault job list)', 2)
    if a.cmd == 'list':
        js = c.call('GET', '/jobs', timeout=60)['jobs']
        if a.json:
            print(json.dumps(js, indent=1, ensure_ascii=False))
        elif not js:
            print('no jobs (results are kept 30 min; a vault restart drops every job)')
        for j in ([] if a.json else js):
            print(f"{j['id']}  {j['op']:<22} {job_line(j)}" + (f", {j['bytes']} bytes" if j.get('bytes') else ''))
        return 0
    if a.cmd == 'cancel':
        j = c.call('POST', f'/jobs/{a.id}/cancel', {}, timeout=60)
        print(f"job {j['id']}: {j['state']}" + (' (stops at its next LLM step)' if j['state'] == 'running' else ''))
        return 0
    deadline = time.monotonic() + max(0.0, a.max)
    while True:
        left = deadline - time.monotonic()
        wait = int(max(0, min(25, left)))
        j = c.call('GET', f'/jobs/{a.id}?wait={wait}', timeout=wait + 60, ok_codes=(404,))
        if j.get('code') == 'no_such_job':
            die(j.get('error') or 'no such job', 1)
        if j.get('state') not in ('queued', 'running'):
            break
        if left <= 0:
            if a.json:
                print(json.dumps(j, indent=1, ensure_ascii=False))
            elif a.partial:
                print_partial(j)
            print(f"vault: job {a.id} still running ({job_line(j)}). Wait again: vault job wait {a.id} [--max 230]",
                  file=sys.stderr)
            sys.exit(EXIT_CODE_RUNNING)
    if a.json:
        print(json.dumps(j, indent=1, ensure_ascii=False))
        return 0 if j['state'] == 'done' else 1
    rec_path = os.path.join(JOB_DIR, a.id + '.json')
    try:
        with open(rec_path, encoding='utf-8') as f:
            rec = json.load(f)
    except (OSError, ValueError):
        rec = None
    if j['state'] != 'done':
        if a.partial:
            print_partial(j)
        err = j.get('error') or {}
        die(f"job {a.id} {j['state']}: {err.get('error') or 'no result'}", http_exit(j.get('status'), err.get('code'))
            if j['state'] == 'failed' else 1)
    res = j.get('result')
    if isinstance(res, dict) and 'exit_code' in res and 'stdout' in res:
        emit(res)                                      # tg and llm-run: tgread's / llm-local's own output
    if rec and isinstance(rec.get('argv'), list):
        method, route = next(((m, r) for (m, r), op in JOB_ROUTES.items() if op == j['op']), (None, None))
        return main(rec['argv'], client=ReplayClient(c, (method, route), j))
    print(json.dumps(res, indent=1, ensure_ascii=False))
    return 0


def emit(res):
    """tgread/llm-local style result: stdout, stderr, exit code."""
    sys.stdout.write(res.get('stdout') or '')
    sys.stderr.write(res.get('stderr') or '')
    sys.stdout.flush()
    sys.exit(int(res.get('exit_code') or 0))


def no_raw_hint(what):
    die(f'--raw is not available here: raw text needs the owner\'s OK. Ask with\n'
        f'  vault raw request --source {what} --reason "why the owner wants it" --query \'{{...}}\'\n'
        f'then: vault raw release REQUEST_ID (after his ✅ tap; fallback mode: the code he reads you)', 2)


def raw_requested(r, release=None):
    """After /raw/request: say how the owner decides and how to pick it up; exit 10 (waiting for him).
    release: the follow-up command without the code (default: vault raw release ID)."""
    rid = r['request_id']
    release = release or f'vault raw release {rid}'
    mins = r['valid_seconds'] // 60
    if r.get('preparing'):
        print(f'request {rid}: sent to the owner first; the vault prepares the text while he decides.')
    if r.get('test_mode'):
        print(f'request {rid}: TEST vault: nothing went to Telegram; the code is in its log (vault admin '
              f'test-instance code). Valid {mins} min.\nRelease it with: {release} CODE')
    elif r.get('approval') == 'buttons':
        print(f'request {rid}: the owner got ✅ Allow once / ❌ Deny buttons on Telegram (valid {mins} min).\n'
              f'After his tap: {release} [--wait S]   (no code; waits up to S s, default 100; exit 10 = not '
              f'decided or the text not ready yet: ask again)')
    else:
        print(f"request {rid}: the owner got a 6-digit code on Telegram (fallback: the vault's bot is not polling; "
              f"valid {mins} min, {r.get('attempts_allowed', 3)} tries).\nRelease it with: {release} CODE")
    sys.exit(EXIT_CODE_PENDING)


# ============================================================================================ tg

def tg_parser():
    p = argparse.ArgumentParser(prog='vault tg', description='tgread through the privacy vault')
    sp = p.add_subparsers(dest='cmd', required=True)

    def msg_opts(x, raw=True):
        x.add_argument('--sync', action='store_true')
        x.add_argument('--full', action='store_true')
        x.add_argument('--llm-max-chars', type=int, dest='llm_max_chars')
        x.add_argument('--json', action='store_true', dest='as_json', help='structured answers as JSON')
        text_opts(x)
        if raw:
            x.add_argument('--raw', action='store_true')
    s = sp.add_parser('search')
    s.add_argument('query')
    for o in ('--chat', '--since', '--until'):
        s.add_argument(o)
    s.add_argument('--from', dest='from_')

    wi.add_argument('--per-chat', type=int, dest='per_chat')
    c = sp.add_parser('chats')
    c.add_argument('--type')
    c.add_argument('--grep')
    c.add_argument('--all', action='store_true')
    c.add_argument('--raw', action='store_true')
    pg = c.add_mutually_exclusive_group()
    pg.add_argument('--pseudonyms', dest='pseudonyms', action='store_true', default=None)
    pg.add_argument('--no-pseudonyms', dest='pseudonyms', action='store_false')
    st = sp.add_parser('status')
    st.add_argument('--check', action='store_true')
    e = sp.add_parser('exclude')
    e.add_argument('action', choices=['add', 'rm', 'list'])
    e.add_argument('chats', nargs='*')
    pu = sp.add_parser('purge')
    pu.add_argument('chat')
    pu.add_argument('--yes', action='store_true')
    sy = sp.add_parser('sync')
    sy.add_argument('--since')
    sy.add_argument('--chats', nargs='+')
    sy.add_argument('--quiet', action='store_true')
    sy.add_argument('--max-seconds', type=int, dest='max_seconds')
    w = sp.add_parser('wipe')
    for o in ('--session', '--data', '--all', '--yes'):

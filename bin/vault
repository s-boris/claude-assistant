    sp.add_parser('allowlist')
    sp.add_parser('selfcheck')
    sp.add_parser('set-credentials')
    lq = sp.add_parser('login-qr')
    lq.add_argument('--out')
    lq.add_argument('--timeout', type=int, default=180)
    lq.add_argument('--password-stdin', action='store_true')

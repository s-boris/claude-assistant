    s.add_argument('--context', type=int)
    s.add_argument('--ask', help='answer this question over the hits (no text)')
    s.add_argument('--kind', choices=ANSWER_KINDS, help='the answer kind for --ask (default short)')
    for o in ('--any', '--substring', '--fts', '--expand'):
        s.add_argument(o, action='store_true')
    msg_opts(s)
    r = sp.add_parser('recent')
    r.add_argument('--chat')
    r.add_argument('--from', dest='from_')
    r.add_argument('-n', type=int)
    g = r.add_mutually_exclusive_group()
    g.add_argument('--hours', type=float)
    g.add_argument('--since')
    msg_opts(r)
    u = sp.add_parser('unread-summary-data')
    u.add_argument('--hours', type=float)
    for o in ('--include-muted', '--include-archived', '--include-read'):
        u.add_argument(o, action='store_true')
    u.add_argument('--per-chat', type=int, dest='per_chat')
    msg_opts(u)
    m = sp.add_parser('summarize')
    m.add_argument('--hours', type=float)
    m.add_argument('--chat')
    for o in ('--unread', '--include-muted', '--include-archived'):
        m.add_argument(o, action='store_true')
    m.add_argument('--per-chat', type=int, dest='per_chat')
    for o in ('--since', '--until'):
        m.add_argument(o)
    m.add_argument('--chats', nargs='+')
    msg_opts(m, raw=False)
    wi = sp.add_parser('window', help='size of a summary window per chat and day: ids and counts only (JSON)')
    wi.add_argument('--hours', type=float)
    wi.add_argument('--chat')
    wi.add_argument('--chats', nargs='+')
    for o in ('--since', '--until'):
        wi.add_argument(o)
    for o in ('--unread', '--include-muted', '--include-archived', '--sync'):

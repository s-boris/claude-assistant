{
  "env": {
    "DISABLE_ERROR_REPORTING": "<redacted>",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "<redacted>",
    "DISABLE_FEEDBACK_COMMAND": "<redacted>",
    "DISABLE_BUG_COMMAND": "<redacted>",
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "<redacted>"
  },
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "EnterPlanMode",
      "mcp__browser__browser_run_code_unsafe"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/home/node"
    ]
  },
  "model": "claude-opus-5-5",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook UserPromptSubmit >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook PreToolUse >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/vault-guard.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/risk-check.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/no-ask.sh PreToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/subagent-rules.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook PostToolUse >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook Stop >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook SubagentStart >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook SubagentStop >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook SessionStart >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook SessionEnd >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/bin/tg-status hook StopFailure >/dev/null 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/no-ask.sh PermissionRequest",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/no-approval.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": false,
    "telegram-plus@home-plugins": false,
    "heartbeat@home-plugins": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "home-plugins": {
      "source": {
        "source": "directory",
        "path": "/home/node/plugins"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.296",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoContinueAtUsageLimit": true,
  "autoUploadSessions": false,
  "autoMode": {
    "environment": [
      "$defaults",
      "Primary use of Claude Code: an always-on personal assistant agent for its single owner, who instructs it over Telegram and Remote Control",
      "Host containment: a Docker container dedicated to this agent, with open internet and no host files mounted. Changing anything inside it (packages, files, cron jobs, its own processes) is in scope",
      "Key internal services: the Telegram bot (telegram MCP tools, api.telegram.org) is the owner's private channel to the agent; sending messages and files to the owner's allowlisted chat is expected"
    ]
  }
}

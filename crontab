# The bot's own crontab. entrypoint installs it at boot; after editing run: crontab ~/crontab
MAILTO=""
PATH=/home/node/bin:/home/node/.local/bin:/usr/local/bin:/usr/bin:/bin

# Pinned Telegram status board: re-render it, and turn a stale "working" (no hook activity for 10 min) into idle.
*/5 * * * * /home/node/bin/tg-status refresh >/dev/null 2>&1

# Weekly digest for the owner (Sunday afternoon, Zurich time): drop a note; the heartbeat runs the weekly-digest subagent.
3 15 * * 0 echo "Weekly digest due $(date +\%F). Run the weekly-digest subagent (effort xhigh), review it, send it as one rich Telegram message." > /home/node/inbox/digest-$(date +\%s).md

# Hardware-error trend (~/bin/hwtrend, read-only, reuses unraid-health's collector): one sample/day in
# ~/.local/state/hwtrend/; ~/inbox note only when a SMART/btrfs/array error counter goes up or a temp is hot 2 days running.
7 8 * * * /home/node/bin/hwtrend >> /home/node/.local/state/hwtrend/cron.log 2>&1

# CPU heat logger (~/bin/cputemp-log, 2026-10-16, fix 0 of ~/reports/unraid/cpu-heat-2026-10-16.md; read-only, no
# tokens): keep its loop alive (flock; one persistent ssh session reading /sys). 10 s in the vault job windows, else 60 s;
# daily CSV in ~/.local/state/cputemp/ (14 days). `cputemp-log summary [day]`.
*/5 * * * * /home/node/bin/cputemp-log ensure >/dev/null 2>> /home/node/.local/state/cputemp/cron.err

# Unraid health check (strictly read-only, one `ssh unraid` session): silent unless something new needs
# attention, then a short `tg` text to the owner + a note in ~/inbox. Details: unraid-health --help
13 8 * * * /home/node/bin/unraid-health >> /home/node/.local/state/unraid-health/cron.log 2>&1

# Durable reminders (~/bin/remind): move due ones into ~/inbox for the next heartbeat.
* * * * * /home/node/bin/remind due >/dev/null 2>&1

# Weekly birthday check, Mondays 09:07: drop a note; the heartbeat checks the calendar for birthdays in the next 7 days and messages the owner only if there are any.
7 9 * * 1 echo "Weekly birthday check $(date +\%F): look up birthdays in the owner's Google Calendar for the next 7 days (contacts' birthdays and the people-and-dates memory). If any, send ONE short message listing them with a gift idea for close people. If none, stay silent. Then the calendar gap pass: list events in the next 60 days with no description and no location; enrich the obviously public ones (concerts, raves, festivals, games: venue address, doors/start, headliner, ticket status, last train home to the owner's home as a weekday estimate) as a Details block + location, notificationLevel NONE, never change times/titles; skip private/personal events (memory calendar-enrichment); no message." > /home/node/inbox/birthdays-$(date +\%s).md

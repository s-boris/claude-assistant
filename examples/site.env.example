# Your values for the placeholders this repository uses. Copy to site.env, edit, then run
#   tools/localize.sh site.env
# It rewrites bin/, claude/, templates/, examples/, dash/, boot.sh and crontab in place (not tests/, which keep the placeholders).
SERVER_NAME=homesrv              # your home server's hostname (the scripts reach it as `ssh unraid`, see docs/CONFIGURATION.md)
PUBLIC_DOMAIN=example.net        # your domain for the dashboard / remote-browser vhosts (dash.<domain>, browser.<domain>)
LAN_PREFIX=198.51.100.           # your LAN prefix: the first three octets plus the dot
OWNER_FIRST_NAME=Alex            # used in letters and as the Seerr / Home Assistant user name
OWNER_EMAIL=owner@example.com
TELEGRAM_CHAT_ID=100000001       # your Telegram user id (also in ~/.claude/channels/telegram/access.json allowFrom)
HOME_TOWN=Exampletown            # defaults for weather, transport and letters
